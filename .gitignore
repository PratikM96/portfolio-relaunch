# reference mockups (visual source, not shipped). No trailing slash: `_reference` is a link to Drive, and a trailing-slash pattern matches directories only, so `_reference/` stops ignoring it and offers the private masters up for commit in a public repo.
_reference

# dependencies
node_modules/

# build output
dist/

# astro
.astro/

# cloudflare
.wrangler/

# env / secrets
.env
.env.production
.dev.vars

# os / editor
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# claude.ai/design sync — account-specific tooling, not site source (public repo keeps this out, like _reference/)
ds-bundle/
.design-sync/

# local agent state: settings plus git worktrees that contain their own .wrangler/.astro
.claude/

# perf: raw Lighthouse runs (regenerate via scripts/perf/run.sh)
scripts/perf/out/
