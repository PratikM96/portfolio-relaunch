---
/**
 * Base.astro — site-wide chrome: the <head>, console rail, mobile bar, footer
 * and shared scripts. Page content slots into .stage > .pad.
 *
 * `variant` picks the rail: 'default' (site nav + readout) or 'case-study'
 * (back link, scroll-spy section index, project scoreboard).
 */
import '../styles/tokens.css';
import '../styles/global.css';
import Brandmark from '../components/Brandmark.astro';
import { getImage } from 'astro:assets';
import { siteOrigin, personRef } from '../lib/schema';
import { ogCard } from '../lib/media';
import headshot from '../assets/headshot-4x5.jpg';

import type { RailSection, ScoreLine } from '../lib/work-type';

interface Props {
  /** <title> text. Falls back to the brand line. */
  title?: string;
  /** <meta name="description">. Optional. */
  description?: string;
  /** Rail mode. */
  variant?: 'default' | 'case-study';
  /** default rail: nav item to mark active (href without leading '#'). */
  activeNav?: string;
  /** case-study rail: section-index nav items (also drives scroll-spy). */
  sections?: RailSection[];
  /** case-study rail: persistent project scoreboard (Type/Role/Year). */
  scoreboard?: ScoreLine[];
  /** case-study rail + mobile: back link to the work index. */
  back?: { href: string; label: string };
  /** OG/Twitter share image, root-relative; resolved to an absolute URL. Defaults to /og/default.png. */
  image?: string;
  /** LCP image to preload with high priority (root-relative), e.g. the home hero poster. */
  preloadImage?: string;
  /** og:type. Defaults to 'article' for a case study, 'website' otherwise. */
  ogType?: string;
  /** Emit a robots noindex directive (e.g. the 404 page). */
  noindex?: boolean;
  /** Extra JSON-LD @graph nodes (CreativeWork, BlogPosting, BreadcrumbList) merged with the site Person + WebSite. */
  schema?: Record<string, unknown>[];
}

const {
  title = 'Pratik Mehta | Creative Marketing Lead',
  description,
  variant = 'default',
  activeNav = 'home',
  sections = [],
  scoreboard = [],
  back = { href: '/work', label: '← Index, all work' },
  image = ogCard('default'),
  preloadImage,
  ogType,
  noindex = false,
  schema = [],
} = Astro.props;

const isCase = variant === 'case-study';
// A case study is always an article, so the two travel together rather than
// every case-study page passing both.
const resolvedOgType = ogType ?? (isCase ? 'article' : 'website');
// Case studies pass no activeNav, so highlight Work.
const drawerActive = isCase ? 'work' : activeNav;

// Default rail nav; `id` is matched against the `activeNav` prop. The mobile drawer
// renders the same list. Resume is required here: /resume passes activeNav="resume".
const nav = [
  { ix: '01', id: 'home', label: 'Home', href: '/' },
  { ix: '02', id: 'work', label: 'Work', href: '/work' },
  { ix: '03', id: 'about', label: 'About', href: '/about' },
  { ix: '04', id: 'resume', label: 'Resume', href: '/resume' },
  { ix: '05', id: 'brand', label: 'Brand', href: '/brand' },
  { ix: '06', id: 'journal', label: 'Journal', href: '/journal' },
  { ix: '07', id: 'contact', label: 'Contact', href: '/contact' },
];

const year = 2026; // static; avoids per-request Date() in the worker

// Absolute URLs for canonical + share cards. Strips the .html the 'file' build
// format leaves behind, so these match how Cloudflare serves the page: no
// extension, no trailing slash.
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

// Site-wide Person + WebSite graph, plus per-page nodes from the `schema` prop.
const origin = siteOrigin(Astro.site);
// Person.image wants a photo OF the person, not a branded share card. Run it through the
// image pipeline so the URL is the hashed, optimized asset the pages already serve.
const personImage = await getImage({ src: headshot, width: 800, format: 'webp' });
const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${origin}/#pratik`,
      name: 'Pratik Mehta',
      url: `${origin}/`,
      jobTitle: 'Creative Marketing Lead',
      email: 'mailto:mehtadpratik@gmail.com',
      image: `${origin}${personImage.src}`,
      address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY', addressCountry: 'US' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'New York University' },
      sameAs: ['https://linkedin.com/in/pratikm96', 'https://instagram.com/pratikm96', 'https://x.com/pratikm96'],
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      name: 'Pratik Mehta',
      url: `${origin}/`,
      publisher: personRef(origin),
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {/* No canonical on a noindex page — naming a preferred URL for a page you
        are also telling crawlers to drop is a contradictory pair of signals. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    {/* Feed autodiscovery, site-wide on purpose: the title names the FEED, not
        the page, so a reader can subscribe from anywhere. Matches rss.xml's own
        <title>; if that changes, change this too. */}
    <link rel="alternate" type="application/rss+xml" title="Pratik Mehta | Journal" href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Share cards. Image is a same-origin /og/*.png at 1200x630. */}
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="Pratik Mehta" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* Describes the card as an image, not the page — og:title already carries
        the page title, and the card renders that same title as its artwork. */}
    <meta property="og:image:alt" content="Pratik Mehta share card" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@pratikm96" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {/* Browser UI tint. No `media` — the theme is [data-theme], not the OS
        preference; the no-flash script below rewrites `content` to match.
        These two hexes are the only place --n-950 / --n-0 are written out:
        a <meta> attribute and a pre-paint script can't read a CSS variable.
        If the ramp ends move, move them here too. */}
    <meta name="theme-color" content="#0B0B0A" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(ldGraph)} />

    {/* Favicon bundle — files live in /public, served at root. Every file in the
        generated set is declared here or in the manifest; an undeclared one ships as
        dead weight, and each needs its own public/_headers cache entry. */}
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Pratik" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* no-flash: set theme before paint */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('pm-theme');
          if (!t) {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', t === 'light' ? '#FBFAF6' : '#0B0B0A');
        } catch (e) {}
      })();
    </script>

    {/* Self-hosted, same-origin (@font-face in tokens.css). No font CDN. */}
    <link rel="preload" href="/fonts/ClashDisplay-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ClashGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Variable.woff2" as="font" type="font/woff2" crossorigin />

    {/* LCP image: discovered late in the DOM, so preload it ahead of CSS/fonts. */}
    {preloadImage && (
      <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />
    )}
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <style>
  /* type tiers — family/weight/tracking only; rules below set size + colour */
  .skip-link {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }


      .skip-link { position: fixed; top: 10px; left: 10px; z-index: 99999; padding: var(--space-sm) var(--space-md); border-radius: var(--radius-md); background: var(--surface-raised); color: var(--text); font-size: var(--fs-xs); text-transform: uppercase; text-decoration: none; transform: translateY(-160%); transition: transform var(--dur-base) var(--ease-standard); }
      .skip-link:focus { transform: none; outline: 2px solid var(--accent-fill); outline-offset: 2px; }
    </style>
    {/* CONSOLE RAIL */}
    <aside class:list={['console', isCase && 'cs']}>
      {
        isCase ? (
          <Fragment>
            <a class="brand" href="/" aria-label="Pratik Mehta - home">
              <Brandmark size={26} title={undefined} />
              <span class="wm">Pratik Mehta</span>
            </a>
            <a class="back" href={back.href}>{back.label}</a>
            <nav class="cs-nav" id="cs-nav">
              {sections.map((s, i) => (
                <a href={s.href} class:list={[i === 0 && 'active']}>
                  <span class="ix">{s.ix}</span>
                  {s.label}
                </a>
              ))}
            </nav>
            {/* optional rail extras — only journal fills this slot */}
            <slot name="rail" />
            <div class="spacer" />
            <div class="scoreboard">
              {scoreboard.map((l) => (
                <div class="line">
                  <span class="k">{l.k}</span>
                  <span class:list={['v', l.accent && 'accent']}>{l.v}</span>
                </div>
              ))}
              <div class="tg" role="group" aria-label="Color theme">
                <button data-set="dark" aria-pressed="true">Dark</button>
                <span class="sep">·</span>
                <button data-set="light" aria-pressed="false">Light</button>
              </div>
            </div>
          </Fragment>
        ) : (
          <Fragment>
            <a class="brand" href="/" aria-label="Pratik Mehta - home">
              <Brandmark size={26} title={undefined} />
              <span class="wm">Pratik Mehta</span>
            </a>
            <div class="role">Creative Marketing<br />Lead</div>
            <nav id="rail-nav">
              {nav.map((n) => (
                <a href={n.href} class={n.id === activeNav ? 'active' : undefined}>
                  <span class="ix">{n.ix}</span>
                  {n.label}
                </a>
              ))}
            </nav>
            {/* persistent about-me blurb (locked bio — System Master) */}
            <div class="rail-bio">
              <span class="bio-k">About</span>
              <p>Most of my work is making sure the creative and the marketing are actually solving the same problem.</p>
            </div>
            <div class="spacer" />
            <div class="readout">
              <div class="status"><span class="dot" />Open to roles</div>
              <div class="line"><span>Loc</span><b>New York</b></div>
              <div class="line"><span>Local</span><b id="clock">//</b></div>
              <div class="line theme-line">
                <span>Theme</span>
                <span class="tg" role="group" aria-label="Color theme">
                  <button data-set="dark" aria-pressed="true">Dark</button>
                  <span class="sep">·</span>
                  <button data-set="light" aria-pressed="false">Light</button>
                </span>
              </div>
            </div>
          </Fragment>
        )
      }
    </aside>

    {/* MOBILE BAR */}
    <div class="console-mobile">
      <a class="brand" href="/" aria-label="Pratik Mehta - home">
        <Brandmark size={18} title={undefined} />
        <span>Pratik Mehta</span>
      </a>
      <button
        class="menu-btn"
        id="menu-open"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        {/* 2×2 node grid — echoes the brandmark's node geometry */}
        <span /><span /><span /><span />
      </button>
    </div>

    {/* MOBILE DRAWER — full-screen nav, ≤900px only */}
    <div class="m-drawer" id="mobile-drawer" aria-hidden="true">
      <div class="m-drawer-head">
        <a class="brand" href="/" aria-label="Pratik Mehta - home">
          <Brandmark size={18} title={undefined} />
          <span>Pratik Mehta</span>
        </a>
        <button class="menu-close" id="menu-close" aria-label="Close menu">✕</button>
      </div>
      <nav class="m-nav">
        {nav.map((n) => (
          <a href={n.href} class={n.id === drawerActive ? 'active' : undefined}>
            <span class="ix">{n.ix}</span>
            {n.label}
          </a>
        ))}
      </nav>
      <div class="m-readout">
        {/* Availability leads, then the identity/location pair, then the control.
            The status line split the two data lines when it sat between them. */}
        <div class="status"><span class="dot" />Open to roles</div>
        {/* The market identity lives in the desktop rail, which is hidden below 900px, so
            without this line mobile carried no identity anywhere on the site. */}
        <div class="line"><span>Role</span><b>Creative Marketing Lead</b></div>
        <div class="line"><span>Loc</span><b>New York</b></div>
        <div class="line theme-line">
          <span>Theme</span>
          <span class="tg" role="group" aria-label="Color theme">
            <button data-set="dark" aria-pressed="true">Dark</button>
            <span class="sep">·</span>
            <button data-set="light" aria-pressed="false">Light</button>
          </span>
        </div>
      </div>
    </div>

    <div class="stage" id="top">
      <div class="pad">
        <main id="main">
          <slot />
        </main>

        <footer class="foot">
          {/* The tagline's tail drops below 560px — at full length it wrapped to a
              second line carrying only "end". */}
          <span class="mono">© {year} Pratik Mehta / One system<span class="foot-tail">, end to end</span></span>
          <div class="fl">
            <a href="/work">Work</a>
            <a href="/about">About</a>
            <a href="/resume">Resume</a>
            <a href="/brand">Brand</a>
            <a href="/journal">Journal</a>
            <a href="/contact">Contact</a>
            <a href="/privacy">Privacy</a>
            <button type="button" class="foot-cookies" data-consent-reopen>Cookies</button>
          </div>
        </footer>
      </div>
    </div>

    {/* Cookie consent + gated Google Analytics (GA4). gtag loads only after Accept. */}
    <div class="consent" id="consent" hidden>
      <p class="consent-txt">Google Analytics measures site traffic. No ads, no cross-site tracking. <a href="/privacy">Privacy</a></p>
      <div class="consent-btns">
        <button type="button" data-consent="deny">Decline</button>
        <button type="button" class="primary" data-consent="grant">Accept</button>
      </div>
    </div>
    <style>
  /* type tiers — family/weight/tracking only; rules below set size + colour */
  .consent button {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }


      .consent { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 9998; max-width: 700px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-lg); padding: var(--space-md) var(--space-lg); background: var(--surface-raised); border: 1px solid var(--border-strong); border-radius: var(--radius-xl); box-shadow: var(--shadow-raised); }
      .consent[hidden] { display: none; }
      .consent-txt { flex: 1; min-width: 260px; margin: 0; font-size: var(--fs-sm); line-height: 1.5; color: var(--text-secondary); text-wrap: balance; }
      .consent-txt a { color: var(--accent-text); text-decoration: underline; }
      .consent-btns { display: flex; gap: var(--space-sm); flex: none; }
      .consent button { font-size: var(--fs-2xs); text-transform: uppercase; padding: var(--space-xs) var(--space-md); border-radius: var(--radius-full); cursor: pointer; border: 1px solid var(--border-strong); background: transparent; color: var(--text); transition: border-color var(--dur-base) var(--ease-standard), background var(--dur-base) var(--ease-standard); }
      .consent button:hover { border-color: var(--text); }
      .consent button.primary { background: var(--accent-fill); border-color: var(--accent-fill); color: var(--on-accent); }
      .consent button:focus-visible { outline: 2px solid var(--accent-fill); outline-offset: 2px; }
      /* type + colour come from `.foot .fl button` in global.css */
      .foot-cookies { background: none; border: 0; padding: 0; cursor: pointer; }
    </style>
    {/* Consent/GA gate + site chrome (theme, drawer, clock, reveal, scroll-spy).
        Whether Vite inlines this or hoists it to /_astro/ depends on
        `assetsInlineLimit` and can flip as the bundle grows — check the build,
        don't assume. */}
    <script>
      import '../scripts/consent.ts';
      import '../scripts/site-chrome.ts';
    </script>
  </body>
</html>
