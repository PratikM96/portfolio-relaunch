---
/**
 * EmbeddedDemo.astro — concept launcher. Each tab is an anchor to a live view
 * under /concepts/[project]/: hover or focus previews it in the stage, click
 * launches it. The `featured` tab shows by default.
 *
 * A tab authors only its `view`. The link and the still both derive from it, the still
 * through the image pipeline like every other case-study asset.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { conceptView } from '../lib/media';

type Tab = {
  /** Tab label (e.g. "Clipper"). */
  label: string;
  /** Caption shown over the stage when active. */
  cap: string;
  /** Microsite route segment; the link and the still both derive from it. */
  view: string;
  /** Centerpiece view, shown by default. */
  featured?: boolean;
};
interface Props {
  heading: string;
  /** Concept slug under /concepts/ and src/assets/concepts/. */
  project: string;
  tabs: Tab[];
  /** "Open full demo" target (the concept index). */
  openHref: string;
  foot: string;
}
const { heading, project, tabs, openHref, foot } = Astro.props;

const stills = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/concepts/*/preview-*.webp',
  { eager: true },
);
// Resolved up front: the stage swaps images at runtime, so each tab carries its processed
// src and srcset rather than a path the browser has to guess at.
const resolved = await Promise.all(
  tabs.map(async (t) => {
    const key = `../assets/concepts/${project}/preview-${t.view}.webp`;
    const mod = stills[key];
    if (!mod) throw new Error(`EmbeddedDemo: missing ${key.replace('../', 'src/')} for tab "${t.label}"`);
    const img = await getImage({ src: mod.default, widths: [480, 800, 1280, 1600], format: 'webp' });
    return { ...t, href: conceptView(project, t.view), src: img.src, srcset: img.srcSet.attribute };
  }),
);
const featuredIndex = resolved.findIndex((t) => t.featured);
const activeIndex = featuredIndex >= 0 ? featuredIndex : 0;
const active = resolved[activeIndex] ?? resolved[0];
const SIZES = '(max-width: 900px) 100vw, (max-width: 1400px) 70vw, 1100px';
---

<div class="embed rev">
  <div class="ehead">
    <span class="el">{heading}</span>
    <a class="open" href={openHref}>Open full demo ↗</a>
  </div>
  <div class="etabs">
    {
      resolved.map((t, i) => (
        <a
          class:list={['etab', i === activeIndex && 'on']}
          href={t.href}
          data-cap={t.cap}
          data-img={t.src}
          data-srcset={t.srcset}
        >
          {t.label}
        </a>
      ))
    }
  </div>
  <a class="estage" href={active.href} aria-label={`Open the ${active.label} view`}>
    {/* A plain <img>, not <Image>: embedded-demo.ts swaps src + srcset on tab change, so
        the markup has to stay writable. Lazy because it sits far below the fold. */}
    <img
      class="estage-img"
      src={active.src}
      srcset={active.srcset}
      sizes={SIZES}
      alt={active.cap}
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
    {/* `cap` is the still's ALT text only. It used to also print over the image;
        overlaid on a screenshot it competed with the UI the still is there to show. */}
    <span class="estage-go">Open ↗</span>
  </a>
  <div class="efoot">{foot}</div>
</div>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + color */
  .embed .ehead .el,
  .embed .ehead .open,
  .embed .etabs .etab,
  .embed .estage .estage-go,
  .embed .efoot {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }


  .embed { border: 1px solid var(--border-strong); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); margin-top: var(--space-lg); }
  .embed .ehead { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); padding: var(--space-md) var(--space-md); border-bottom: 1px solid var(--border); background: var(--surface-raised); }
  .embed .ehead .el { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-secondary); }
  .embed .ehead .open { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text); display: flex; align-items: center; gap: var(--space-xs); transition: color var(--dur-quick) var(--ease-standard); }
  .embed .ehead .open:hover { color: var(--accent-text); }
  /* Wrap, never scroll sideways: a scrolling strip hides views behind a gesture
     with nothing on screen saying there are more. Whole tabs move to a second row. */
  .embed .etabs { display: flex; flex-wrap: wrap; border-bottom: 1px solid var(--border); }
  .embed .etabs .etab { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); background: none; border: none; border-bottom: 2px solid transparent; padding: var(--space-sm) var(--space-md); cursor: pointer; white-space: nowrap; transition: color var(--dur-quick) var(--ease-standard), border-color var(--dur-quick) var(--ease-standard); }
  .embed .etabs .etab:hover { color: var(--text-secondary); }
  .embed .etabs .etab.on { color: var(--text); border-bottom-color: var(--accent-fill); }
  .embed .estage { position: relative; display: block; aspect-ratio: var(--ratio-wide); overflow: hidden; }
  .embed .estage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-settle) var(--ease-standard); }
  .embed .estage:hover img { transform: scale(var(--scale-hover)); }
  .embed .estage .estage-go { position: absolute; top: 14px; right: 14px; font-size: var(--fs-2xs); text-transform: uppercase; color: var(--n-0); background: var(--scrim-chip); backdrop-filter: blur(6px); padding: var(--space-2xs) var(--space-sm); border-radius: var(--radius-none); opacity: 0; transition: opacity var(--dur-quick) var(--ease-standard); }
  .embed .estage:hover .estage-go, .embed .estage:focus-visible .estage-go { opacity: 1; }
  .embed .efoot { padding: var(--space-sm) var(--space-md); font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); border-top: 1px solid var(--border); }
</style>

<script>
  import '../scripts/embedded-demo.ts';
</script>
