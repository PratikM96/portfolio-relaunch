---
/**
 * CloseCTA.astro — the shared closing CTA above the footer on the main content
 * pages. Case studies and journal posts omit it on purpose: they end with their
 * own next-case / rail flow.
 */
interface Props {
  /** Optional anchor id. Home keeps `contact` for backwards-compatible deep links. */
  id?: string;
}
const { id } = Astro.props;
---

<section class:list={['close-cta', 'rev']} id={id}>
  {/* The meta pair leads, matching the home hero: it sets the terms the heading then
      closes on. Two lines, not one joined by a separator: "roles / New York" reads as
      a geographic restriction on the roles, which is not the scope. */}
  <div class="cta-avail">Based in New York<br />Open to creative or marketing roles</div>
  <h2 class="close-h cta-h">Let's build it as one system.</h2>
  <div class="btn-row">
    <a class="btn btn-p" href="/contact">Get in touch →</a>
    <a class="btn btn-g" href="/work">View work →</a>
    <a class="btn btn-g" href="/resume">View resume →</a>
  </div>
</section>

<style>
  /* type tier — the availability line is a mono label */
  .cta-avail { font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track); }

  /* .close-h (display heading) and .btn / .btn-row come from global.css */
  .close-cta { padding: var(--space-4xl) 0; }
  .cta-avail { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-secondary); margin-bottom: var(--space-lg); line-height: 1.7; }
  .close-cta .cta-h { max-width: 16ch; margin-bottom: var(--space-xl); }

  /* Three pills stop fitting one row here, and wrapping left "View resume" hanging
     alone. Grid instead: the primary spans, the two ghosts split under it. */
  @media (max-width: 560px) {
    .close-cta .btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
    .close-cta .btn { text-align: center; padding-left: var(--space-md); padding-right: var(--space-md); }
    .close-cta .btn-p { grid-column: 1 / -1; }
  }
</style>
