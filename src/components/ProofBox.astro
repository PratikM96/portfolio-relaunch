---
/**
 * ProofBox.astro — the proof block for every case study: a grid of figures plus an optional note. One uniform style; no metric-vs-scope split.
 */
import StatFigure from './StatFigure.astro';
type Figure = { value: string; unit?: string; label: string };
interface Props {
  figures: Figure[];
  /** Optional caption/rationale under the figures. */
  note?: { label: string; text: string };
}
const { figures, note } = Astro.props;
// Columns track the figure count so there's no empty cell. Capped at 4.
const cols = Math.min(figures.length, 4);
---

<div class="cs-proof rev">
  <div class="grid" style={`--cols:${cols}`}>
    {
      figures.map((f) => (
        <div class="r">
          <div class="f"><StatFigure value={f.value} unit={f.unit} /></div>
          <div class="l">{f.label}</div>
        </div>
      ))
    }
  </div>
  {note && (
    <div class="cs-note">
      <div class="m-label">{note.label}</div>
      <p>{note.text}</p>
    </div>
  )}
</div>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + color */
  .cs-proof .r .f {
    font-family: var(--t-display-font); font-weight: var(--t-display-weight); letter-spacing: var(--t-display-track);
  }
  .cs-proof .r .l,
  .cs-note .m-label {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }

  .cs-proof { border: 1px solid var(--border-strong); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface); }
  .cs-proof .grid { display: grid; grid-template-columns: repeat(var(--cols, 4), 1fr); gap: 1px; background: var(--border); }
  /* container query so the figure scales to its cell and never wraps */
  .cs-proof .r { background: var(--surface); padding: var(--space-xl) var(--space-lg); container-type: inline-size; }
  /* sizing only — the number/accent split lives in StatFigure */
  .cs-proof .r .f { font-size: clamp(26px, 22cqi, 50px); line-height: 1; white-space: nowrap; }
  /* description: max two lines */
  .cs-proof .r .l { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); margin-top: var(--space-sm); line-height: 1.5; max-width: var(--measure-xs); display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cs-note { padding: var(--space-xl) var(--space-xl); border-top: 1px solid var(--border); }
  .cs-note .m-label { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-sm); }
  .cs-note p { font-size: var(--fs-base); line-height: 1.6; color: var(--text-secondary); max-width: var(--measure-xl); }

  @media (max-width: 1100px) { .cs-proof .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cs-proof .grid { grid-template-columns: 1fr; } }
</style>
