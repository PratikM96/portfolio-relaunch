---
/**
 * Scoreboard.astro — the case-study hero board: a 4-up grid of cells, each either plain meta or a `stat` (large figure + optional accent unit).
 */
import StatFigure from './StatFigure.astro';
type Cell = {
  k: string;
  v: string;
  /** Render `v` as a large proof figure. */
  stat?: boolean;
  /** Unit suffix (e.g. "M", "%", "screens") — stat cells only. */
  unit?: string;
};
interface Props {
  cells: Cell[];
}
const { cells } = Astro.props;
---

<div class="sb-board rev">
  {
    cells.map((c) => (
      <div class:list={['sb-cell', c.stat && 'stat']}>
        <div class="k">{c.k}</div>
        <div class="v">{c.stat ? <StatFigure value={c.v} unit={c.unit} /> : c.v}</div>
      </div>
    ))
  }
</div>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + color */
  .sb-cell.stat .v {
    font-family: var(--t-display-font); font-weight: var(--t-display-weight); letter-spacing: var(--t-display-track);
  }
  .sb-cell .v {
    font-family: var(--t-h3-font); font-weight: var(--t-h3-weight); letter-spacing: var(--t-h3-track);
  }
  .sb-cell .k {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }

  .sb-board {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px;
    background: var(--border); border: 1px solid var(--border);
    border-radius: var(--radius-md); overflow: hidden; margin-top: var(--space-2xl);
  }
  .sb-cell { background: var(--surface); padding: var(--space-lg) var(--space-lg); container-type: inline-size; }
  .sb-cell .k { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); margin-bottom: var(--space-sm); }
  .sb-cell .v { font-size: var(--fs-base); color: var(--text); line-height: var(--lh-tight); }
  /* No accent override here: figureRuns accents every numeral, including a unitless
     one like "100", so the old `.acc` flag had nothing left to do. */
  /* container query so the figure scales to its cell and stays on one line */
  .sb-cell.stat .v { font-size: clamp(18px, 16cqi, 34px); white-space: nowrap; }

  @media (max-width: 1100px) { .sb-board { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .sb-board { grid-template-columns: 1fr; } }
</style>
