---
/**
 * StatFigure.astro — the single renderer for every stat number on the site. figureRuns decides the neutral/accent split; accent only changes color.
 */
import { figureRuns } from '../lib/figure';
interface Props {
  value: string;
  unit?: string;
}
const { value, unit = '' } = Astro.props;
const runs = figureRuns(value + unit);
---

{runs.map((r) => (r.accent ? <span class="u">{r.t}</span> : <Fragment>{r.t}</Fragment>))}

<style>
  .u { color: var(--accent-text); }
</style>
