---
/**
 * WorkIndex.astro — filter bar, index table, sticky preview pane. Shared by the
 * home "Selected work" section and /work; the caller owns the chrome around it.
 *
 *   entries       the entries to render (the caller curates and sorts)
 *   disciplines   show the 6 discipline bucket filters (default: type only)
 *   stickyFilter  pin the filter bar on scroll
 */
import type { CollectionEntry } from 'astro:content';
import { TYPE_LABEL } from '../lib/work-type';
import { firstYear, roleShort } from '../lib/content';

interface Props {
  entries: CollectionEntry<'work'>[];
  disciplines?: boolean;
  stickyFilter?: boolean;
}
const { entries, disciplines = false, stickyFilter = false } = Astro.props;

// Six discipline buckets; a project matches if any raw discipline is a member.
const buckets = [
  { label: 'Brand', token: 'brand', members: ['Brand', 'Strategy', 'Leadership'] },
  { label: 'Social & Content', token: 'social', members: ['Social', 'Content', 'Paid'] },
  { label: 'UI/UX', token: 'uiux', members: ['UI/UX', 'Product'] },
  { label: 'Motion', token: 'motion', members: ['Motion', 'Video', 'Broadcast'] },
  { label: 'AI', token: 'ai', members: ['AI'] },
  { label: 'Production', token: 'production', members: ['Print', 'Environmental', 'Photo', 'Photography', 'Event', 'Digital', 'Design'] },
];
const bucketsFor = (disc: string[]) => buckets.filter((b) => disc.some((d) => b.members.includes(d)));

const projects = entries.map((e, i) => ({
  n: String(i + 1).padStart(2, '0'),
  name: e.data.title,
  type: e.data.type,
  disc: e.data.disciplines.slice(0, 2).join(', '),
  // "In-house" says the engagement; the role says what he was inside it. Shortened here:
  // the full role, with its employment type, renders on the case-study scoreboard.
  role: roleShort(e.data.role),
  year: firstYear(e.data.year),
  href: `/work/${e.data.slug}`,
  // poster + sources derive from the slug alone (/wc/<slug>/)
  slug: e.data.slug,
  lede: e.data.lede,
  tags: [e.data.type, ...bucketsFor(e.data.disciplines).map((b) => b.token)].join(' '),
}));
const first = projects[0]!;
---

<div class:list={['filters', stickyFilter && 'sticky']} id="filters" role="group" aria-label="Filter work">
  <span class="fl-k">Filter</span>
  <span id="fstatus" role="status" aria-live="polite" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)"></span>
  <button class="on" data-f="all" aria-pressed="true">All</button>
  <span class="div"></span>
  <button data-f="in-house" aria-pressed="false">In-house</button>
  <button data-f="agency" aria-pressed="false">Agency</button>
  <button data-f="concept" aria-pressed="false">Concept</button>
  {disciplines && (
    <Fragment>
      <span class="div"></span>
      {buckets.map((b) => <button data-f={b.token} aria-pressed="false">{b.label}</button>)}
    </Fragment>
  )}
</div>

<div class:list={['index-wrap', stickyFilter && 'has-sticky-filter']}>
  <div class="idx" id="idx">
    {/* Two-line row. `#` and Year bracket a 2x2 block: project + role on the first line,
        category + disciplines on the second. Four facets across one line never fitted here,
        because the sticky preview pane leaves the table about 620px at 1440. */}
    {/* Header labels only the first line. Category and Discipline are self-evident on the
        second, and labelling them made the header two rows tall for no gain. */}
    <div class="idx-head">
      <span class="ix">#</span>
      <span class="cells"><span>Project</span><span>Role</span></span>
      <span class="yr">Year</span>
    </div>
    {projects.map((p, i) => (
      <a
        class:list={['idx-row', i === 0 && 'active']}
        href={p.href}
        data-tags={p.tags}
        data-slug={p.slug}
        data-t={p.name}
        data-d={p.lede}
      >
        <span class="ix">{p.n}</span>
        <span class="cells">
          <span class="nm"><b>{p.name}</b></span>
          <span class="role">{p.role}</span>
          <span class:list={['ty', p.type]}>{TYPE_LABEL[p.type]}</span>
          <span class="disc">{p.disc}</span>
        </span>
        <span class="yr">{p.year}</span>
      </a>
    ))}
    <div class="idx-empty" hidden>No work matches that filter.</div>
  </div>
  <div class="card preview">
    <div class="pv-img" id="pv-img">
      <video id="pv-video" class="pv-video" muted loop playsinline preload="none"></video>
    </div>
    <div class="pv-meta"><div class="pv-t" id="pv-t">{first.name}</div><div class="pv-d" id="pv-d">{first.lede}</div></div>
    <a class="pv-open" id="pv-open" href={first.href}>Open case study →</a>
  </div>
</div>

<script>
  import { applyCardPoster, applyCardSources, onThemeChange } from '../scripts/card-video';
  import { prefersReducedMotion } from '../scripts/motion';

  // Sticky preview + single-select filter (type or discipline token).
  const rows = [...document.querySelectorAll<HTMLAnchorElement>('.idx-row')];
  const pvImg = document.getElementById('pv-img');
  const pvT = document.getElementById('pv-t');
  const pvD = document.getElementById('pv-d');
  const pvOpen = document.getElementById('pv-open');
  const pvVideo = document.getElementById('pv-video') as HTMLVideoElement | null;
  const empty = document.querySelector<HTMLElement>('.idx-empty');
  const reduceMotion = prefersReducedMotion();

  // `clip: false` sets the poster only — no <source>, no load(), no bytes. The
  // initial selection uses it because the pane is display:none below 1100px,
  // where wiring the clip downloaded into an invisible element. Hover upgrades it.
  function setPreview(r: HTMLAnchorElement, clip = true) {
    if (!pvImg || !pvT || !pvD) return;
    rows.forEach((x) => x.classList.remove('active'));
    r.classList.add('active');
    const slug = r.dataset.slug;
    if (pvVideo && slug) {
      if (!clip) {
        applyCardPoster(pvVideo, slug);
      } else {
        applyCardSources(pvVideo, slug);
        if (!reduceMotion) {
          pvVideo.currentTime = 0;
          pvVideo.play().catch(() => {});
        }
      }
    }
    pvT.textContent = r.dataset.t ?? '';
    pvD.textContent = r.dataset.d ?? '';
    const href = r.getAttribute('href');
    if (pvOpen && href && href !== '#') pvOpen.setAttribute('href', href);
  }

  rows.forEach((r) => {
    r.addEventListener('mouseenter', () => setPreview(r));
    r.addEventListener('focus', () => setPreview(r));
  });
  if (rows[0]) setPreview(rows[0], false);

  // On theme flip, re-point the preview. A poster-only pane stays poster-only.
  onThemeChange(() => {
    const active = document.querySelector<HTMLAnchorElement>('.idx-row.active');
    if (pvVideo && active?.dataset.slug) {
      if (!pvVideo.dataset.wired) { applyCardPoster(pvVideo, active.dataset.slug); return; }
      const wasPlaying = !pvVideo.paused;
      applyCardSources(pvVideo, active.dataset.slug);
      if (wasPlaying && !reduceMotion) pvVideo.play().catch(() => {});
    }
  });

  const fbtns = [...document.querySelectorAll<HTMLButtonElement>('#filters button')];
  fbtns.forEach((b) => {
    b.addEventListener('click', () => {
      fbtns.forEach((x) => { x.classList.remove('on'); x.setAttribute('aria-pressed', 'false'); });
      b.classList.add('on');
      b.setAttribute('aria-pressed', 'true');
      const f = b.dataset.f ?? 'all';
      let firstVisible: HTMLAnchorElement | null = null;
      rows.forEach((r) => {
        const ok = f === 'all' || (r.dataset.tags ?? '').split(' ').includes(f);
        r.classList.toggle('hidden', !ok);
        if (ok && !firstVisible) firstVisible = r;
      });
      if (empty) empty.hidden = !!firstVisible;
      const status = document.getElementById('fstatus');
      if (status) {
        const n = rows.filter((r) => !r.classList.contains('hidden')).length;
        status.textContent = n + (n === 1 ? ' project shown' : ' projects shown');
      }
      if (firstVisible) setPreview(firstVisible);
    });
  });
</script>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + colour */
  .idx-row .nm b,
  .preview .pv-meta .pv-t {
    font-family: var(--t-h3-font); font-weight: var(--t-h3-weight); letter-spacing: var(--t-h3-track);
  }
  .preview .pv-meta .pv-d {
    font-family: var(--t-body-font); font-weight: var(--t-body-weight); letter-spacing: var(--t-body-track);
  }
  .filters .fl-k,
  .filters button,
  .idx-head span,
  .idx-row .ty,
  .idx-row .role,
  .idx-row .disc,
  .idx-empty,
  .preview .pv-open {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }
  .idx-row .ix,
  .idx-row .yr {
    font-family: var(--t-data-font); font-weight: var(--t-data-weight); letter-spacing: var(--t-data-track);
  }


  /* ===== filter bar (sticky only when the caller asks, e.g. /work) ===== */
  .filters { display: flex; flex-wrap: wrap; gap: var(--space-xs); align-items: center; padding: var(--space-lg) 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .filters.sticky { position: sticky; top: 0; background: var(--bg); z-index: 20; }
  .filters .fl-k { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); margin-right: var(--space-xs); }
  .filters button { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); background: none; border: 1px solid var(--border-strong); border-radius: var(--radius-none); padding: var(--space-xs) var(--space-sm); cursor: pointer; transition: color var(--dur-base) var(--ease-standard), border-color var(--dur-base) var(--ease-standard), background var(--dur-base) var(--ease-standard); }
  .filters button:hover { color: var(--text); }
  .filters button.on { color: var(--on-accent); background: var(--accent-fill); border-color: var(--accent-fill); }
  .filters .div { width: 1px; height: 20px; background: var(--border-strong); margin: 0 var(--space-2xs); }

  /* ===== index + preview ===== */
  .index-wrap { display: grid; grid-template-columns: 1fr 380px; gap: var(--space-2xl); align-items: start; padding: var(--space-lg) 0 0; }
  /* on /work the index is last before the footer, so it owns the gap;
     on the home the wrapping .block section already provides it */
  .index-wrap.has-sticky-filter { padding-bottom: var(--space-4xl); }
  /* # and Year bracket a 2x2 block, so each line carries two facets instead of four. */
  .idx-head, .idx-row { display: grid; grid-template-columns: 34px minmax(0, 1fr) 56px; gap: var(--space-md); align-items: center; }
  .cells { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--space-2xs) var(--space-md); align-items: baseline; min-width: 0; }
  .idx-head { padding: var(--space-sm) 0; border-bottom: 1px solid var(--border); }
  .idx-head span { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); }
  .idx-head .yr { text-align: right; }
  .idx-row { padding: var(--space-lg) 0; border-bottom: 1px solid var(--border); cursor: pointer; transition: padding-left var(--dur-base) var(--ease-standard); }
  .idx-row.hidden { display: none; }
  .idx-row:last-of-type { border-bottom: none; }
  .idx-row:hover, .idx-row.active { padding-left: var(--space-sm); }
  .idx-row .ix { font-size: var(--fs-xs); color: var(--text-muted); }
  .idx-row.active .ix { color: var(--accent-text); }
  .idx-row .nm b { font-size: var(--fs-xl); color: var(--text-secondary); transition: color var(--dur-base) var(--ease-standard); }
  .idx-row:hover .nm b, .idx-row.active .nm b { color: var(--text); }
  /* the category chip sits on the second line, under the title it qualifies */
  .idx-row .ty { justify-self: start; font-size: var(--fs-3xs); text-transform: uppercase; padding: 3px var(--space-xs); border-radius: var(--radius-none); border: 1px solid var(--border-strong); color: var(--text-muted); white-space: nowrap; }
  /* every engagement type accents — not gated on type (CLAUDE.md §3) */
  .idx-row .ty.in-house, .idx-row .ty.agency, .idx-row .ty.concept { color: var(--accent-text); border-color: color-mix(in srgb, var(--accent-fill) 35%, transparent); }
  .idx-row .role { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-secondary); }
  .idx-row .disc { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); }
  .idx-row .yr { font-size: var(--fs-xs); color: var(--text-secondary); text-align: right; }
  .idx-empty { padding: var(--space-xl) 0; font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); }

  /* surface comes from global .card */
  .preview { position: sticky; top: 40px; overflow: hidden; }
  /* a sticky filter bar sits at the top, so push the preview down to clear it */
  .has-sticky-filter .preview { top: 96px; }
  .preview .pv-img { aspect-ratio: var(--ratio-wide); position: relative; }
  .preview .pv-img .pv-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .preview .pv-meta { padding: var(--space-md); }
  .preview .pv-meta .pv-t { font-size: var(--fs-2xl); }
  .preview .pv-meta .pv-d { font-size: var(--fs-sm); color: var(--text-secondary); margin-top: var(--space-sm); line-height: 1.55; }
  .preview .pv-open { display: block; border-top: 1px solid var(--border); padding: var(--space-md) var(--space-md); font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-secondary); }
  .preview .pv-open:hover { color: var(--accent-text); }

  @media (max-width: 1100px) {
    .index-wrap { grid-template-columns: 1fr; }
    .preview { display: none; }
  }
  @media (max-width: 560px) {
    .idx-head { display: none; }
    /* One cell per line, and the year joins the stack rather than holding a column. */
    .idx-row { grid-template-columns: 24px minmax(0, 1fr); gap: var(--space-2xs) var(--space-sm); }
    .cells { grid-template-columns: minmax(0, 1fr); gap: var(--space-2xs); }
    .idx-row .yr { grid-column: 2; text-align: left; }
  }
</style>
