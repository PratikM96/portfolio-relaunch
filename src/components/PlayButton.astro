---
/**
 * PlayButton.astro — the click-to-play overlay on a video. One implementation
 * for the case-study hero wall and the output gallery; they differ only in
 * size. The parent marks itself `.is-playing` to hide it (see motion.ts).
 */
interface Props {
  /** Accessible label, e.g. `Play the DealNews video`. */
  label: string;
  /** Diameter of the white disc in px. The triangle scales with it. */
  size?: number;
  /** Class the wiring script queries for. */
  hook: string;
}
const { label, size = 64, hook } = Astro.props;
---

<button class:list={['play-btn', hook]} type="button" aria-label={label} style={`--play-size:${size}px`}>
  <span class="tri" aria-hidden="true"></span>
</button>

<style>
  .play-btn {
    position: absolute; inset: 0; width: 100%; height: 100%;
    display: grid; place-items: center; border: 0; cursor: pointer;
    background: var(--scrim-base);
    transition: background-color var(--dur-quick) var(--ease-standard);
  }
  .play-btn:hover { background: var(--scrim-hover); }
  .play-btn::before {
    content: ''; position: absolute;
    width: var(--play-size); height: var(--play-size);
    border-radius: var(--radius-full); background: var(--n-0);
    box-shadow: var(--shadow-overlay);
    transition: transform var(--dur-quick) var(--ease-standard);
  }
  .play-btn:hover::before { transform: scale(var(--scale-control)); }
  /* A CSS triangle is a border trick, so its box is the full width but its
     visual mass sits at 1/3 from the left. `place-items: center` centers the
     box, so nudge right by w/6 to center what the eye sees. Both sizes were
     nudged by hand before and neither landed on it. */
  .play-btn .tri {
    --tri-w: calc(var(--play-size) * 0.28);
    position: relative; z-index: 1; width: 0; height: 0; border-style: solid;
    border-width: calc(var(--play-size) * 0.172) 0 calc(var(--play-size) * 0.172) var(--tri-w);
    border-color: transparent transparent transparent var(--n-950);
    margin-left: calc(var(--tri-w) / 6);
  }
  /* Handing over to native controls is the one state change on the site that used to hard-cut. It fades instead, and `visibility` (not `display`) is what removes it from the pointer and the tab order, so the opacity has something to animate. */
  .play-btn { opacity: 1; visibility: visible; transition: background-color var(--dur-quick) var(--ease-standard), opacity var(--dur-quick) var(--ease-standard), visibility 0s; }
  /* the delay sits on the HIDDEN state, so the button leaves after its fade but returns instantly when `ended` clears the flag — same pairing as .m-drawer */
  :global(.is-playing) .play-btn { opacity: 0; visibility: hidden; transition: opacity var(--dur-quick) var(--ease-exit), visibility 0s var(--dur-quick); }
</style>
