---
/**
 * ContributionBox.astro — "My contribution" under the case-study hero scoreboard.
 * The scoreboard carries role, year and headline figure; this carries what he owned.
 *
 * `.rev-load`, not `.rev`: above the fold, and Chromium excludes opacity:0 from LCP (CLAUDE.md §6).
 */
type Contribution = {
  owned?: string;
  team?: string;
  collaborators?: string;
  constraints?: string;
};
interface Props {
  contribution: Contribution;
}
const { contribution: c } = Astro.props;

const rows = [
  { k: 'Owned', v: c.owned },
  { k: 'Team', v: c.team },
  { k: 'Worked with', v: c.collaborators },
  { k: 'Constraints', v: c.constraints },
].filter((r) => !!r.v);
---

{rows.length > 0 && (
  <div class="contrib rev-load">
    <div class="contrib-k">My contribution</div>
    <dl>
      {rows.map((r) => (
        <div class="crow">
          <dt>{r.k}</dt>
          <dd>{r.v}</dd>
        </div>
      ))}
    </dl>
  </div>
)}

<style>
  /* type tiers — family/weight/tracking only; rules below set size + colour */
  .contrib-k,
  .crow dt {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }

  .contrib {
    margin-top: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    padding: var(--space-lg) var(--space-lg);
  }
  .contrib-k { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--accent-text); margin-bottom: var(--space-md); }
  .contrib dl { margin: 0; display: flex; flex-direction: column; gap: var(--space-sm); }
  .crow { display: grid; grid-template-columns: 148px minmax(0, 1fr); gap: var(--space-lg); align-items: baseline; }
  .crow dt { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); }
  .crow dd { margin: 0; font-size: var(--fs-sm); line-height: 1.55; color: var(--text-secondary); max-width: var(--measure-3xl); }

  @media (max-width: 560px) {
    .crow { grid-template-columns: 1fr; gap: var(--space-2xs); }
  }
</style>
