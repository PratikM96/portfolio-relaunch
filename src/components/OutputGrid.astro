---
/**
 * OutputGrid.astro — the case-study output gallery. `blocks` is an ordered list
 * of typed blocks, one asset family per block. Long pages scroll inside a capped
 * frame; videos don't fetch until in view. Per-kind export caps and the video
 * contract: docs/output-assets.md.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PlayButton from './PlayButton.astro';
import { outputClip } from '../lib/media';

type Still = { img: ImageMetadata; imgDark?: ImageMetadata; alt?: string; caption?: string };
type Block =
 | { kind: 'mockup'; flagship?: boolean; items: Still[] }
 | { kind: 'social'; label?: string; cols?: number; items: Still[] }
 | { kind: 'flyer'; label?: string; ratio?: '3:4' | '9:16'; cols?: number; fit?: 'cover' | 'contain'; bg?: 'surface' | 'paper'; items: Still[] }
 | { kind: 'gallery'; label?: string; ratio?: '3:2' | '4:3' | '16:9' | '2:1'; cols?: number; fit?: 'cover' | 'contain'; items: Still[] }
 | { kind: 'longpage'; cols?: number; height?: number; chrome?: 'browser' | 'plain'; items: Still[] }
 | { kind: 'video'; audio?: boolean; ratio?: '16:9' | '1:1'; cols?: number; items: { clip: string; audio?: boolean; alt?: string; caption?: string }[] };

interface Props {
  slug: string;
  blocks?: Block[];
  note?: string;
}
const { slug, blocks, note } = Astro.props;

/**
 * Responsive width ladders, in DEVICE pixels — not CSS px. Each tops out near
 * twice its widest CSS slot, so 2x displays get a sharp candidate. Astro never
 * upscales, so an over-wide ladder just emits fewer candidates.
 */
const W = {
  cols1: [640, 1000, 1400, 1800],
  cols2: [480, 800, 1200, 1600],
  cols3: [360, 600, 900, 1200],
  cols4: [280, 460, 700, 940],
};
const ladderFor = (cols: number) =>
  cols <= 1 ? W.cols1 : cols === 2 ? W.cols2 : cols === 3 ? W.cols3 : W.cols4;

/**
 * Longpage gets a shorter ladder: its sources are whole scrolling pages (up to
 * 1400x9334), so each extra width multiplies against a 9000px height.
 */
const W_LONG: Record<number, number[]> = {
  1: [700, 1000, 1400],
  2: [560, 900, 1200],
  3: [420, 600, 800],
};

/**
 * `sizes` must account for the fixed rail (--rail 264px, 0 below 900px) plus
 * .pad, or it lies to the browser. Below 560px every grid collapses to 2-up.
 */
const GAP = 16;
const cell = (inset: number, c: number) => `calc((100vw - ${inset + GAP * (c - 1)}px) / ${c})`;
const sizesFor = (cols: number) => {
  const c = Math.max(1, cols);
  return [
    `(max-width: 560px) ${cell(48, c > 1 ? 2 : 1)}`,
    `(max-width: 900px) ${cell(64, c)}`,
    cell(392, c),
  ].join(', ');
};

const clipSrc = (clip: string) => outputClip(slug, clip);
---

{
  blocks && (
    <div class="out rev">
      {blocks.map((b) => {
        if (b.kind === 'mockup') {
          return (
            <div class="blk blk-mockup">
              {b.items.map((it) => (
                <figure class="mock">
                  <div class="frame im r-16x9">
                    {it.imgDark ? (
                      // theme-aware pair; the swap is CSS (see .m-dark/.m-light)
                      <>
                        <Image class="m-dark" src={it.imgDark} alt={it.alt ?? ''} widths={ladderFor(1)} sizes={sizesFor(1)} loading="lazy" />
                        <Image class="m-light" src={it.img} alt={it.alt ?? ''} widths={ladderFor(1)} sizes={sizesFor(1)} loading="lazy" />
                      </>
                    ) : (
                      <Image src={it.img} alt={it.alt ?? ''} widths={ladderFor(1)} sizes={sizesFor(1)} loading="lazy" />
                    )}
                  </div>
                  {it.caption && <figcaption>{it.caption}</figcaption>}
                </figure>
              ))}
            </div>
          );
        }
        if (b.kind === 'social') {
          const cols = b.cols ?? 3;
          return (
            <div class="blk blk-social">
              {b.label && <p class="blk-label">{b.label}</p>}
              <div class="grid" style={`--cols:${cols}`}>
                {b.items.map((it) => (
                  <figure class="cell">
                    <div class="frame im r-1x1">
                      <Image src={it.img} alt={it.alt ?? ''} widths={ladderFor(cols)} sizes={sizesFor(cols)} loading="lazy" />
                    </div>
                    {it.caption && <figcaption>{it.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          );
        }
        if (b.kind === 'flyer') {
          const cols = b.cols ?? 3;
          const rClass = b.ratio === '9:16' ? 'r-9x16' : 'r-3x4';
          return (
            <div class="blk blk-flyer">
              {b.label && <p class="blk-label">{b.label}</p>}
              <div class="grid" style={`--cols:${cols}`}>
                {b.items.map((it) => (
                  <figure class="cell">
                    <div class:list={['frame', 'im', rClass, b.fit === 'contain' && 'fit-contain', b.bg === 'paper' && 'bg-paper']}>
                      <Image src={it.img} alt={it.alt ?? ''} widths={ladderFor(cols)} sizes={sizesFor(cols)} loading="lazy" />
                    </div>
                    {it.caption && <figcaption>{it.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          );
        }
        if (b.kind === 'gallery') {
          const cols = b.cols ?? 3;
          const rClass = { '3:2': 'r-3x2', '4:3': 'r-4x3', '16:9': 'r-16x9', '2:1': 'r-2x1' }[b.ratio ?? '3:2'];
          return (
            <div class="blk blk-gallery">
              {b.label && <p class="blk-label">{b.label}</p>}
              <div class="grid" style={`--cols:${cols}`}>
                {b.items.map((it) => (
                  <figure class="cell">
                    <div class:list={['frame', 'im', rClass, b.fit === 'contain' && 'fit-contain']}>
                      <Image src={it.img} alt={it.alt ?? ''} widths={ladderFor(cols)} sizes={sizesFor(cols)} loading="lazy" />
                    </div>
                    {it.caption && <figcaption>{it.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          );
        }
        if (b.kind === 'longpage') {
          const h = b.height ?? 600;
          const cols = Math.min(3, Math.max(1, b.cols ?? 2));
          const lpWidths = W_LONG[cols] ?? W_LONG[3];
          return (
            <div class="blk blk-long" style={`--cols:${cols}`}>
              {b.items.map((it) => {
                const chrome = b.chrome ?? 'plain';
                return (
                  <figure class="long">
                    <div class:list={['frame', 'lp-frame', chrome === 'browser' && 'has-chrome']} style={`--h:${h}px`}>
                      {chrome === 'browser' && (
                        <div class="lp-bar" aria-hidden="true">
                          <span class="dot" /><span class="dot" /><span class="dot" />
                        </div>
                      )}
                      <div class="lp-scroll">
                        <Image src={it.img} alt={it.alt ?? ''} widths={lpWidths} sizes={sizesFor(cols)} loading="lazy" />
                      </div>
                    </div>
                    {it.caption && <figcaption>{it.caption} <span class="hint">/ scroll to explore</span></figcaption>}
                  </figure>
                );
              })}
            </div>
          );
        }
        // video
        const vcols = Math.min(3, Math.max(1, b.cols ?? 1));
        const vr = { '16:9': 'r-16x9', '1:1': 'r-1x1' }[b.ratio ?? '16:9'];
        return (
          <div class="blk blk-video" style={`--cols:${vcols}`}>
            {b.items.map((it) => {
              const s = clipSrc(it.clip);
              const withAudio = it.audio ?? b.audio; // per-item override of the block default
              return (
                <figure class="vid" data-ov-video data-audio={withAudio ? 'true' : 'false'}>
                  <div class:list={['frame', 'im', vr]}>
                    <video
                      data-poster={s.poster}
                      width="1920"
                      height="1080"
                      playsinline
                      preload="none"
                      muted={!withAudio}
                      loop={!withAudio}
                      aria-label={it.alt ?? it.caption ?? ''}
                    >
                      <source src={s.webm} type="video/webm" />
                    </video>
                    {withAudio && <PlayButton label="Play video" hook="ov-play" />}
                  </div>
                  {it.caption && <figcaption>{it.caption}</figcaption>}
                </figure>
              );
            })}
          </div>
        );
      })}
    </div>
  )
}
{note && <p class="out-note">{note}</p>}

<style>
  /* type tiers — family/weight/tracking only; rules below set size + color */
  .blk-label,
  .out figcaption,
  .out-note {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }


  /* ===== typed blocks ===== */
  .out { display: flex; flex-direction: column; gap: var(--space-3xl); }
  .blk-label { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); margin: 0 0 var(--space-md); }

  /* shared media frame + caption */
  .out .im { background: var(--surface-raised); }
  .out figcaption { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); margin-top: var(--space-sm); }
  .out figcaption .hint { color: var(--accent-text); }
  .out figure { margin: 0; }
  .out .im :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* contain: show a whole artwork without cropping */
  .out .im.fit-contain { padding: var(--space-sm); }
  .out .im.fit-contain :global(img) { object-fit: contain; }
  /* paper: warm-white card behind transparent artwork (--n-0 is theme-independent) */
  .out .im.bg-paper { background: var(--n-0); }

  /* aspect boxes — values come from the --ratio-* tokens */
  .r-16x9 { aspect-ratio: var(--ratio-wide); }
  .r-1x1 { aspect-ratio: var(--ratio-square); }
  .r-3x4 { aspect-ratio: var(--ratio-tall); }
  .r-9x16 { aspect-ratio: var(--ratio-portrait); }
  .r-3x2 { aspect-ratio: var(--ratio-photo); }
  .r-4x3 { aspect-ratio: var(--ratio-classic); }
  .r-2x1 { aspect-ratio: var(--ratio-banner); }

  .blk-mockup { display: grid; grid-template-columns: 1fr; gap: var(--space-md); }

  /* Theme-aware mockup pair; dark is the default. :global() because the class
     lands on <Image>'s rendered <img>, which carries no scope attribute. */
  .im :global(.m-light) { display: none; }
  :global(html[data-theme='light']) .im :global(.m-dark) { display: none; }
  :global(html[data-theme='light']) .im :global(.m-light) { display: block; }

  /* social / flyer grids */
  .grid { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: var(--space-md); }

  /* longpage — capped internal-scroll frames, laid out N-up */
  .blk-long { display: grid; grid-template-columns: repeat(var(--cols, 2), 1fr); gap: var(--space-md); align-items: start; }
  .lp-frame { background: var(--surface-raised); }
  .lp-bar { display: flex; align-items: center; gap: var(--space-xs); padding: var(--space-sm) var(--space-md); background: var(--surface); border-bottom: 1px solid var(--img-frame); }
  .lp-bar .dot { width: 10px; height: 10px; border-radius: var(--radius-full); background: var(--border-strong); }
  .lp-scroll { height: var(--h, 600px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .lp-scroll :global(img) { width: 100%; height: auto; display: block; }

  /* video block */
  .blk-video { display: grid; grid-template-columns: repeat(var(--cols, 1), 1fr); gap: var(--space-md); }
  .out .vid video { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (max-width: 900px) {
    .blk-long, .blk-video { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  .out-note { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); margin-top: var(--space-md); }
</style>

<script>
  import { autoPlayInView, wireClickToPlay } from '../scripts/motion';

  // Muted loops autoplay/pause in view; audio clips are click-to-play. The reduced-motion gate lives inside autoPlayInView (via safePlay), so the loops are observed either way and a mid-session flip is honored — filtering them out here would have made the preference a load-time decision.
  const all: HTMLVideoElement[] = [];
  const loops: HTMLVideoElement[] = [];
  document.querySelectorAll<HTMLElement>('[data-ov-video]').forEach((fig) => {
    const video = fig.querySelector('video');
    if (!video) return;
    all.push(video);

    if (fig.dataset.audio === 'true') {
      const btn = fig.querySelector('.ov-play');
      if (btn) wireClickToPlay(fig, video, btn);
      return;
    }
    loops.push(video);
  });

  // A <video poster> fetches eagerly even under preload="none", so these
  // below-the-fold posters are deferred to ~300px before they scroll in.
  if (all.length && 'IntersectionObserver' in window) {
    const posterIO = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const v = e.target as HTMLVideoElement;
          if (v.dataset.poster) { v.poster = v.dataset.poster; v.removeAttribute('data-poster'); }
          obs.unobserve(v);
        }
      },
      { rootMargin: '300px' },
    );
    all.forEach((v) => posterIO.observe(v));
  } else {
    all.forEach((v) => { if (v.dataset.poster) v.poster = v.dataset.poster; });
  }

  autoPlayInView(loops);
</script>
