---
/**
 * /work - the full work index: page head, featured pair, then the shared WorkIndex. Driven by the `work` collection, so the count and year range derive from real entries rather than being authored.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import CloseCTA from '../../components/CloseCTA.astro';
import { TYPE_LABEL } from '../../lib/work-type';
import { BRAND_GROUPS } from '../../lib/brands';
import { sortWork, firstYear } from '../../lib/content';
import { cardPosters } from '../../lib/media';

const entries = sortWork(await getCollection('work'));

// The kicker count + range derive from the collection, never authored.
const allYears = entries.flatMap((e) => e.data.year.match(/\d{4}/g) ?? []).sort();
const yearRange =
  allYears.length === 0
    ? ''
    : allYears[0] === allYears.at(-1)
      ? allYears[0]
      : `${allYears[0]}-${allYears.at(-1)}`;
const count = entries.length;

// Featured pair, shown above the shared index.
const featured = await Promise.all(
  entries
    .filter((e) => e.data.featured)
    .map(async (e) => ({
      name: e.data.title,
      type: e.data.type,
      href: `/work/${e.data.slug}`,
      slug: e.data.slug,
      year: firstYear(e.data.year),
      lede: e.data.lede,
      discLines: e.data.disciplines.slice(0, 3),
      // Both hashed poster URLs, because card-video.ts cannot derive a hashed path at runtime.
      poster: await cardPosters(e.data.slug),
    })),
);

/**
 * Hiring-problem router. Filters answer "what engagement was this"; this answers "which two or three should I open". Routes mirror the Job Search Targeting proof router. Titles read from the collection; an unknown slug throws at build time.
 */
const bySlug = new Map(entries.map((e) => [e.data.slug, e]));
// Short labels so each route stays on one line. Full titles wrapped and broke the leader
// rule. Every slug used in ROUTES needs one, or the build throws.
const SHORT: Record<string, string> = {
  'sportime-clubs': 'SPORTIME',
  dealnews: 'DealNews',
  frc: 'Forest Road',
  raa: 'RAA',
  'agency-fiveeighty': 'FiveEighty',
  'pipeline-medical': 'Pipeline',
  'sr-love-and-care': 'SR Love and Care',
  jmtp: 'JMTP',
  'the-ninth': 'The Ninth',
  level: 'Level',
  wisp: 'WISP',
  'portfolio-system': 'Portfolio System',
};
const label = (slug: string) => {
  if (!bySlug.has(slug)) throw new Error(`/work router references "${slug}", which is not in the work collection`);
  const s = SHORT[slug];
  if (!s) throw new Error(`/work router has no SHORT label for "${slug}"`);
  return s;
};
const ROUTES: { need: string; slugs: string[] }[] = [
  { need: 'Creative marketing leadership', slugs: ['sportime-clubs', 'dealnews'] },
  { need: 'Social and content leadership', slugs: ['sportime-clubs', 'dealnews', 'frc'] },
  { need: 'Brand and art direction', slugs: ['raa', 'agency-fiveeighty', 'pipeline-medical'] },
  { need: 'Integrated campaign systems', slugs: ['sportime-clubs', 'dealnews', 'raa'] },
  { need: 'Product and AI-adjacent creative', slugs: ['the-ninth', 'wisp', 'level'] },
  { need: 'Design systems and front-end', slugs: ['portfolio-system', 'the-ninth'] },
  { need: 'Team building and mentorship', slugs: ['sportime-clubs', 'sr-love-and-care'] },
  { need: 'Experiential and live production', slugs: ['raa', 'jmtp', 'agency-fiveeighty'] },
];
const routes = ROUTES.map((r) => ({
  need: r.need,
  items: r.slugs.map((s) => ({ slug: s, name: label(s), href: `/work/${s}` })),
}));
---

{/* No preload for the first featured poster, even though it is the LCP element: `rel=preload` cannot be theme-conditional, so it fetched the dark still for light-theme visitors too and then went unused. The inline script below sets the poster during parse, which is nearly as early as the preload was and is right for both themes. */}
<Base title="Work | Pratik Mehta" image="/og/work.png" description="In-house, agency, and concept, filterable by type and discipline. Each one opens to a full case study." activeNav="work">
  <header class="phead">
    <div class="page-kicker">[ Work ] / {count} {count === 1 ? 'project' : 'projects'} / {yearRange}</div>
    <h1 class="rev-load page-h1">The work,<br />as <span class="signal">one index.</span></h1>
    <p class="lead rev-load">Start with the project closest to the role you are hiring for. The index below covers in-house, agency, volunteer, and self-initiated work, filterable by engagement and discipline, and each one opens to a full case study.</p>
  </header>

  {/* HIRING ROUTER — answers "which two or three", which the lead invites.
      rev-load because it lands above the fold on desktop; see CLAUDE.md §6 on why
      opacity-based reveals do not belong up here. */}
  <section class="router rev-load">
    <h2 class="router-h">Start with the hiring problem</h2>
    <dl class="router-grid">
      {routes.map((r) => (
        <div class="router-row">
          <dt>{r.need}</dt>
          <span class="lead-rule" aria-hidden="true"></span>
          <dd>
            {r.items.map((it, i) => (
              <Fragment>{i > 0 && <span class="sep" aria-hidden="true">/</span>}<a href={it.href}>{it.name}</a></Fragment>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {/* featured pair */}
  <h2 class="sr-only">Featured projects</h2>
  <section class="feat rev-load">
    {featured.map((p) => (
      <a class="card card--interactive fcard" href={p.href}>
        <span class:list={['badge', p.type]}>{TYPE_LABEL[p.type]}</span>
        <div class="im">
          {/* No <source>: card-video.ts adds one on first hover, so an untouched card costs nothing. No `poster` attribute either, on any card: the still inverts with the theme, and a static attribute cannot know the theme, so the first card is set by the inline script below and every later one by the observer. */}
          <video class="fcard-video" muted loop playsinline preload="none" data-slug={p.slug} data-poster={p.poster.dark} data-poster-light={p.poster.light}></video>
        </div>
        <div class="meta">
          <div>
            <h3>{p.name}</h3>
            <span class="yr">{p.year}</span>
            <p>{p.lede}</p>
          </div>
          <div class="disc">
            {p.discLines.map((d, i) => (
              <Fragment>{i > 0 && <br />}{d}{i < p.discLines.length - 1 ? ' /' : ''}</Fragment>
            ))}
          </div>
        </div>
      </a>
    ))}
  </section>

  {/* The first card is this page's LCP element, so its poster is set here rather than by the observer that serves the rest. `is:inline` keeps it un-hoisted and parser-blocking, which puts it after the pre-paint theme script in Base.astro and before first paint, so the theme-correct still is the only one ever fetched. card-video.ts leaves it alone afterwards because it only ever adds a poster, never replaces one. */}
  <script is:inline>
    (function () {
      var v = document.querySelector('.fcard-video');
      if (!v) return;
      var light = document.documentElement.getAttribute('data-theme') === 'light';
      v.poster = (light ? v.dataset.posterLight : v.dataset.poster) || v.dataset.poster || '';
    })();
  </script>

  {/* shared filterable index + sticky preview (also used on the home) */}
  <h2 class="sr-only">All projects</h2>
  <WorkIndex entries={entries} disciplines stickyFilter />

  {/* Sits BELOW the index because the page's job is opening the right case study, and 30+ names above the featured pair bury them. The lead sentence is what keeps the section inside the never-Pratik's-clients rule, so it never becomes a footnote. */}
  <section class="brands rev" id="brands">
    <h2 class="brands-h">Brands and organizations</h2>
    {/* "How the work came in" rather than "the role it ran through", because Direct engagements is not a role. The second sentence is the load-bearing one and does not change. */}
    <p class="brands-lead">Grouped by how the work came in. At the agencies these were the agency's clients, not mine.</p>
    {/* A group with no separate brands keeps its row and its leader and says nothing after it. The empty <dd> is deliberate: filler copy there would mean nothing. */}
    <dl class="brands-list">
      {BRAND_GROUPS.map((g) => (
        <div class="brand-row">
          <dt>{g.href ? <a href={g.href}>{g.label}</a> : g.label}</dt>
          <span class="lead-rule" aria-hidden="true"></span>
          {g.brands.length > 0 && (
            <dd>
              {g.brands.map((b, i) => (
                <Fragment>{i > 0 && <span class="sep" aria-hidden="true">/</span>}{b}</Fragment>
              ))}
            </dd>
          )}
        </div>
      ))}
    </dl>
  </section>

  <CloseCTA />
</Base>

<script>
  import { wireHoverCards } from '../../scripts/card-video';

  // Featured cards - same controller as the home bento tiles.
  wireHoverCards('.fcard', 'video');
</script>

<style>
  /* type tiers - family/weight/tracking only; rules below set size + color */
  .fcard h3 {
    font-family: var(--t-h3-font); font-weight: var(--t-h3-weight); letter-spacing: var(--t-h3-track);
  }
  .fcard .disc {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }
  .fcard .yr {
    font-family: var(--t-data-font); font-weight: var(--t-data-weight); letter-spacing: var(--t-data-track);
  }
  /* label tier: the router head and its project lists are uppercase mono */
  .router-h,
  .router-row dd,
  .brands-h,
  .brand-row dd {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }
  .brand-row dt {
    font-family: var(--t-h3-font); font-weight: var(--t-h3-weight); letter-spacing: var(--t-h3-track);
  }


  /* ===== hiring router ===== */
  .router { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: var(--space-xl) 0; margin-bottom: var(--space-3xl); }
  .router-h { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--accent-text); margin-bottom: var(--space-lg); }
  /* auto-fit, not a fixed 2 columns: the project lists are `nowrap`, so a column narrower
     than ~500px pushed them past the viewport and the page scrolled sideways at 1100px.
     This drops to one column whenever two would be too tight, at any width. */
  .router-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 500px), 1fr)); gap: var(--space-xs) var(--space-2xl); }
  /* Need and projects on one line, joined by a dotted leader. Short labels (SHORT above)
     are what keep it to one line; full titles wrapped and broke the rule. */
  .router-row { display: flex; align-items: baseline; gap: var(--space-sm); padding: var(--space-xs) 0; }
  .router-row dt { font-size: var(--fs-sm); color: var(--text-secondary); white-space: nowrap; }
  .router-row .lead-rule { flex: 1; min-width: var(--space-lg); border-bottom: 1px dotted var(--border-strong); transform: translateY(-3px); }
  .router-row dd { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); margin: 0; white-space: nowrap; }
  .router-row dd a { color: var(--text-muted); transition: color var(--dur-quick) var(--ease-standard); }
  .router-row dd a:hover { color: var(--accent-text); }
  .router-row dd .sep { padding: 0 var(--space-2xs); opacity: 0.5; }

  @media (max-width: 560px) {
    /* The leader has nowhere to go at this width, so stack instead. */
    .router-row { flex-direction: column; align-items: flex-start; gap: var(--space-2xs); }
    .router-row dt { white-space: normal; }
    .router-row .lead-rule { display: none; }
    .router-row dd { white-space: normal; line-height: 1.7; }
  }

  /* page head */
  .phead { padding: var(--space-4xl) 0 var(--space-3xl); }
  /* type + measure come from the shared .lead primitive in global.css */
  .phead p { margin-top: var(--space-lg); }

  /* featured pair */
  .feat { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); padding-bottom: var(--space-3xl); }
  /* surface + hover come from global .card / .card--interactive */
  .fcard { position: relative; overflow: hidden; display: block; }
  .fcard .im { aspect-ratio: var(--ratio-landscape); overflow: hidden; position: relative; }
  .fcard .im img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-settle) var(--ease-standard); }
  .fcard:hover .im img { transform: scale(var(--scale-hover)); }
  /* card clip sits over the cover, showing its resolved-logo poster; plays on hover */
  .fcard-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-settle) var(--ease-standard); }
  .fcard:hover .fcard-video { transform: scale(var(--scale-hover)); }
  .fcard .meta { padding: var(--space-lg); display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-md); }
  .fcard h3 { font-size: var(--fs-2xl); }
  .fcard .yr { font-size: var(--fs-xs); color: var(--accent-text); margin-top: var(--space-xs); display: block; }
  .fcard p { font-size: var(--fs-sm); color: var(--text-secondary); margin-top: var(--space-sm); max-width: var(--measure-md); }
  .fcard .disc { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); text-align: right; white-space: nowrap; line-height: 1.8; }
  /* .badge / .badge.in-house / .badge.agency / .badge.concept come from global.css */

  /* ===== brands and organizations ===== */
  /* Same band treatment as the router, so the two read as a matched pair bracketing the index. */
  .brands { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: var(--space-xl) 0; margin-top: var(--space-3xl); }
  .brands-h { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--accent-text); margin-bottom: var(--space-sm); }
  .brands-lead { font-size: var(--fs-sm); color: var(--text-secondary); max-width: var(--measure-lg); margin-bottom: var(--space-lg); }
  /* Leader row from .router-row, but the names take their OWN full-width line beneath it rather than sharing the row. Sharing it never fit: the shell spends 264px on the rail plus padding, so the longest groups wrapped to two right-aligned lines even at 1440 and three at 1100. Full width fits every group on one line at desktop and degrades to two, left aligned, instead of a ragged right-aligned block. */
  .brand-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2xs) var(--space-sm); padding: var(--space-md) 0; }
  .brand-row dt { font-size: var(--fs-sm); color: var(--text); white-space: nowrap; }
  .brand-row dt a { color: var(--text); transition: color var(--dur-quick) var(--ease-standard); }
  .brand-row dt a:hover { color: var(--accent-text); }
  .brand-row .lead-rule { flex: 1; min-width: var(--space-lg); border-bottom: 1px dotted var(--border-strong); transform: translateY(-3px); }
  /* flex-basis 100% is what forces the second line. A group with no brands renders no <dd> at all, so it keeps its leader row and adds no empty gap. */
  .brand-row dd { flex: 0 0 100%; margin: 0; font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); line-height: 1.9; }
  .brand-row dd .sep { padding: 0 var(--space-2xs); opacity: 0.5; }

  @media (max-width: 1100px) {
    .feat { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    /* Same treatment as .router-row: the leader has nowhere to go at this width, so drop it and let the group name wrap. */
    .brand-row dt { white-space: normal; }
    .brand-row .lead-rule { display: none; }
  }
  @media (max-width: 900px) {
    .phead { padding: var(--space-3xl) 0 var(--space-2xl); }
  }
</style>
