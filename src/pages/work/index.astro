---
/**
 * /work — the full work index: page head, featured pair, then the shared
 * WorkIndex. Driven by the `work` collection, so the count and year range
 * derive from real entries rather than being authored.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import CloseCTA from '../../components/CloseCTA.astro';
import { TYPE_LABEL } from '../../lib/work-type';

const entries = (await getCollection('work')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.title.localeCompare(b.data.title);
});

// Index views show the earliest year of a range; the kicker count + range derive
// from the collection so the page never overstates how much work exists.
const earliestYear = (y: string) => y.match(/\d{4}/g)?.at(0) ?? y;
const allYears = entries.flatMap((e) => e.data.year.match(/\d{4}/g) ?? []).sort();
const yearRange =
  allYears.length === 0
    ? ''
    : allYears[0] === allYears.at(-1)
      ? allYears[0]
      : `${allYears[0]}—${allYears.at(-1)}`;
const count = entries.length;

// Featured pair, shown above the shared index.
const featured = entries
  .filter((e) => e.data.featured)
  .map((e) => ({
    name: e.data.title,
    type: e.data.type,
    href: `/work/${e.data.slug}`,
    slug: e.data.slug,
    year: earliestYear(e.data.year),
    lede: e.data.lede,
    discLines: e.data.disciplines.slice(0, 3),
  }));
---

{/* The first featured poster is the LCP element, and a <video poster> is
    invisible to the preload scanner — hence the explicit preload. */}
<Base title="Work · Pratik Mehta" image="/og/work.png" description="In-house, agency, and concept, filterable by type and discipline. Each one opens to a full case study." activeNav="work" preloadImage={featured.length ? `/wc/${featured[0].slug}/poster.webp` : undefined}>
  <header class="phead">
    <div class="page-kicker">[ Work ] · {count} {count === 1 ? 'project' : 'projects'} · {yearRange}</div>
    <h1 class="rev-load page-h1">The work,<br />as <span class="signal">one index.</span></h1>
    <p class="lead rev-load">In-house, agency, and concept, filterable by type and discipline. Pick the two or three that answer your question. Each one opens to a full case study.</p>
  </header>

  {/* featured pair */}
  <h2 class="sr-only">Featured projects</h2>
  <section class="feat rev-load">
    {featured.map((p) => (
      <a class="card card--interactive fcard" href={p.href}>
        <span class:list={['badge', p.type]}>{TYPE_LABEL[p.type]}</span>
        <div class="im">
          <video class="fcard-video" muted loop playsinline preload="none" data-slug={p.slug} poster={`/wc/${p.slug}/poster.webp`}>
            <source src={`/wc/${p.slug}/card.webm`} type="video/webm" />
          </video>
        </div>
        <div class="meta">
          <div>
            <h3>{p.name}</h3>
            <span class="yr">{p.year}</span>
            <p>{p.lede}</p>
          </div>
          <div class="disc">
            {p.discLines.map((d, i) => (
              <Fragment>{i > 0 && <br />}{d}{i < p.discLines.length - 1 ? ' /' : ''}</Fragment>
            ))}
          </div>
        </div>
      </a>
    ))}
  </section>

  {/* shared filterable index + sticky preview (also used on the home) */}
  <h2 class="sr-only">All projects</h2>
  <WorkIndex entries={entries} disciplines stickyFilter />

  <CloseCTA />
</Base>

<script>
  import { wireHoverCards } from '../../scripts/card-video';

  // Featured cards — same controller as the home bento tiles.
  wireHoverCards('.fcard', 'video');
</script>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + colour */
  .fcard h3 {
    font-family: var(--t-h3-font); font-weight: var(--t-h3-weight); letter-spacing: var(--t-h3-track);
  }
  .fcard .disc {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }
  .fcard .yr {
    font-family: var(--t-data-font); font-weight: var(--t-data-weight); letter-spacing: var(--t-data-track);
  }


  /* page head */
  .phead { padding: var(--space-4xl) 0 var(--space-3xl); }
  /* type + measure come from the shared .lead primitive in global.css */
  .phead p { margin-top: var(--space-lg); }

  /* featured pair */
  .feat { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); padding-bottom: var(--space-3xl); }
  /* surface + hover come from global .card / .card--interactive */
  .fcard { position: relative; overflow: hidden; display: block; }
  .fcard .im { aspect-ratio: var(--ratio-landscape); overflow: hidden; position: relative; }
  .fcard .im img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-deliberate) var(--ease-standard); }
  .fcard:hover .im img { transform: scale(1.03); }
  /* card clip sits over the cover, showing its resolved-logo poster; plays on hover */
  .fcard-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-deliberate) var(--ease-standard); }
  .fcard:hover .fcard-video { transform: scale(1.03); }
  .fcard .meta { padding: var(--space-lg); display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-md); }
  .fcard h3 { font-size: var(--fs-2xl); }
  .fcard .yr { font-size: var(--fs-xs); color: var(--accent-text); margin-top: var(--space-xs); display: block; }
  .fcard p { font-size: var(--fs-sm); color: var(--text-secondary); margin-top: var(--space-sm); max-width: 42ch; }
  .fcard .disc { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); text-align: right; white-space: nowrap; line-height: 1.8; }
  /* .badge / .badge.in-house / .badge.agency / .badge.concept come from global.css */

  @media (max-width: 1100px) {
    .feat { grid-template-columns: 1fr; }
  }
  @media (max-width: 900px) {
    .phead { padding: var(--space-3xl) 0 var(--space-2xl); }
  }
</style>
