---
/**
 * /work/[slug] — the single case-study route. One template serves every
 * engagement type; copy and structure come entirely from the entry data. The
 * only type-driven bits are cosmetic (hero badge class, rail Type line).
 */
import { getCollection } from 'astro:content';
import type { GetStaticPaths, ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import Scoreboard from '../../components/Scoreboard.astro';
import ContributionBox from '../../components/ContributionBox.astro';
import ProseSection from '../../components/ProseSection.astro';
import SysFlow from '../../components/SysFlow.astro';
import Decisions from '../../components/Decisions.astro';
import OutputGrid from '../../components/OutputGrid.astro';
import ProofBox from '../../components/ProofBox.astro';
/* Statically imported although both render conditionally. Astro drops an unrendered component's SCRIPT but keeps its CSS, so PerfTable ships to all 12 case studies while rendering on 1, EmbeddedDemo to all 12 while rendering on 3. Keep the static import: a dynamic one trades an `astro check` failure on a possibly-null component for ~2.4KB gzipped of 8.2KB, about 10ms. */
import PerfTable from '../../components/PerfTable.astro';
import EmbeddedDemo from '../../components/EmbeddedDemo.astro';
import PlayButton from '../../components/PlayButton.astro';
import { TYPE_LABEL, TYPE_SCOREBOARD } from '../../lib/work-type';
import { sortWork, firstYear, isYearRange } from '../../lib/content';
import { heroVideo as heroVideoPath, ogCard, conceptView } from '../../lib/media';
import { FULL, WIDTHS_FULL } from '../../lib/layout';
import { perfFigure } from '../../lib/perf-claim';
import { siteOrigin, personRef, websiteRef, breadcrumb } from '../../lib/schema';

export const getStaticPaths = (async () => {
  // Same order as the /work index, so the footer "next" walks it and wraps.
  const all = sortWork(await getCollection('work'));
  return all.map((entry, i) => {
    const nx = all[(i + 1) % all.length].data;
    return {
      params: { slug: entry.data.slug },
      props: { entry, nextEntry: { type: nx.type, title: nx.title, slug: nx.slug } },
    };
  });
}) satisfies GetStaticPaths;

const { entry, nextEntry } = Astro.props;
const d = entry.data;
const csNext = {
  kicker: `Next case study / ${TYPE_LABEL[nextEntry.type]}`,
  title: nextEntry.title,
  href: `/work/${nextEntry.slug}`,
};

// Optional hero video, located by slug. The poster goes through the image
// pipeline (src/assets/) because it is the LCP element; only the video, which
// the pipeline can't process, sits in public/. See docs/hero-pipeline.md.
const posters = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/hero/*/poster.webp',
  { eager: true },
);
const heroPoster = posters[`../../assets/hero/${d.slug}/poster.webp`]?.default;

const heroVideo = d.heroVideo ? { webm: heroVideoPath(d.slug) } : null;
if (heroVideo && !heroPoster) {
  throw new Error(`heroVideo is set for "${d.slug}" but src/assets/hero/${d.slug}/poster.webp is missing`);
}

/* Built once and used twice: the <img> below and Base's preload. The poster is this page's LCP element but sits ~10KB into the body, behind the scoreboard, so without a preload the browser cannot discover it until it has parsed past all of that. Passing the same object to both is what stops the preload resolving to a different candidate than the <img> and fetching it twice. */
const heroImg = heroPoster
  ? await getImage({ src: heroPoster, widths: WIDTHS_FULL, sizes: FULL, format: 'webp' })
  : null;

/* Proof figures, with the derived ones resolved before ProofBox sees them so the component stays a dumb renderer. A figure carrying `from` reads the same measured JSON PerfTable renders, which is what stops the two disagreeing: the mobile average was authored as 98 and measured 99.4 a run later. Authored figures pass straight through. `unit` on the figure wins over the resolver's, so a label can still override presentation. */
const proofFigures = d.proof.figures.map((f) =>
  f.from
    ? (() => { const r = perfFigure(f.from!); return { value: r.value, unit: f.unit ?? r.unit, label: f.label }; })()
    : { value: f.value!, unit: f.unit, label: f.label },
);

/* Scoreboard cells resolve the same way, for the same reason: a measured number typed here and derived below is two values for one metric. */
const heroCells = d.hero.map((c) =>
  c.from
    ? (() => { const r = perfFigure(c.from!); return { k: c.k, v: r.value, stat: c.stat, unit: c.unit ?? r.unit }; })()
    : { k: c.k, v: c.v!, stat: c.stat, unit: c.unit },
);

// §Output appears for assets OR a demo; without either it drops and the spine
// renumbers. OutputGrid itself renders only when assets exist.
const outputBlocks = d.output?.blocks;
const hasOutput = !!outputBlocks?.length;
const hasDemo = !!d.demo;
const hasOutputSection = hasOutput || hasDemo;

// Rail (case-study variant) — spine numbered dynamically so Output can drop out.
const spine = ['problem', 'system', 'decisions', ...(hasOutputSection ? ['output'] : []), 'proof', 'reflection'];
const no = (id: string) => String(spine.indexOf(id) + 1).padStart(2, '0');
const spineLabel: Record<string, string> = {
  problem: 'Problem', system: 'System', decisions: 'Decisions', output: 'Output', proof: 'Proof',
};
const sections = spine
  .filter((id) => id !== 'reflection')
  .map((id) => ({ ix: no(id), label: spineLabel[id], href: `#${id}` }));
// A year range (more than one 4-digit year) pluralizes the rail label.
const yearRange = isYearRange(d.year);
const scoreboard = [
  { k: 'Type', v: TYPE_SCOREBOARD[d.type], accent: true },
  { k: 'Role', v: d.role },
  { k: yearRange ? 'Years' : 'Year', v: d.year },
];

// Three segments. The badge and disclosure already mark a concept, and a fourth
// segment just gets truncated in search results.
const pageTitle = `${d.title} | Case study | Pratik Mehta`;

// CreativeWork + breadcrumb; author/publisher reference the site graph in Base.
const origin = siteOrigin(Astro.site);
const workUrl = `${origin}/work/${d.slug}`;
const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${workUrl}#work`,
    name: d.title,
    headline: d.title,
    description: d.description,
    url: workUrl,
    image: `${origin}${ogCard(d.slug)}`,
    author: personRef(origin),
    creator: personRef(origin),
    dateCreated: firstYear(d.year),
    keywords: d.disciplines.join(', '),
    isPartOf: websiteRef(origin),
  },
  breadcrumb(origin, [
    { name: 'Home', path: '/' },
    { name: 'Work', path: '/work' },
    { name: d.title },
  ]),
];

---

<Base
  variant="case-study"
  image={ogCard(d.slug)}
  schema={schema}
  title={pageTitle}
  description={d.description}
  sections={sections}
  scoreboard={scoreboard}
  preloadImage={heroImg?.src}
  preloadImageSrcset={heroImg?.srcSet.attribute}
  preloadImageSizes={heroImg ? FULL : undefined}
>
  {/* SCOREBOARD HERO */}
  <header class="cs-hero">
    <span class:list={['badge', 'badge-lg', d.type, 'rev-load']}>{d.badge}</span>
    <h1 class="rev-load">{d.title}</h1>
    <p class="descr rev-load">{d.lede}</p>
    {d.disclosure && <p class="cs-disclosure rev-load">{d.disclosure}</p>}
    <Scoreboard cells={heroCells} />
    {d.contribution && <ContributionBox contribution={d.contribution} />}
    {heroVideo && heroPoster && (
      <div class="frame cs-wall rev-load" data-cs-video>
        {/* A real <img>, not the video's `poster` attribute, so it gets a
            responsive srcset. It is the LCP element, hence eager + high. */}
        <img
          class="cs-poster"
          src={heroImg!.src}
          srcset={heroImg!.srcSet.attribute}
          sizes={FULL}
          alt={d.coverAlt ?? ''}
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <video
          width="1920" height="1080"
          playsinline preload="none" aria-label={d.coverAlt}
        >
          <source src={heroVideo.webm} type="video/webm" />
        </video>
        <PlayButton label={`Play the ${d.title} video`} size={78} hook="cs-video-play" />
        <span class="cap">{d.coverCaption}</span>
      </div>
    )}
  </header>

  {/* PROBLEM */}
  <section class="block" id="problem">
    <SectionLabel code={no('problem')} title="Problem" variant="case" />
    <ProseSection prose={d.problem.prose} margin={d.problem.margin} />
  </section>

  {/* SYSTEM */}
  <section class="block" id="system">
    <SectionLabel code={no('system')} title="System" variant="case" />
    <ProseSection prose={d.system.prose} margin={d.system.margin} gap />
    <SysFlow steps={d.system.steps} />
  </section>

  {/* DECISIONS */}
  <section class="block" id="decisions">
    <SectionLabel code={no('decisions')} title="Decisions" variant="case" />
    <ProseSection prose={d.decisions.prose} margin={d.decisions.margin} gap />
    <Decisions decisions={d.decisions.items} />
  </section>

  {/* OUTPUT (optional) */}
  {hasOutputSection && (
    <section class="block" id="output">
      <SectionLabel code={no('output')} title="Output" variant="case" />
      {hasOutput && (
        <OutputGrid slug={d.slug} blocks={outputBlocks} note={d.output?.note} />
      )}
      {d.demo && (
        <EmbeddedDemo
          heading={d.demo.heading}
          project={d.demo.project}
          tabs={d.demo.tabs}
          openHref={conceptView(d.demo.project)}
          foot={d.demo.foot}
        />
      )}
    </section>
  )}

  {/* PROOF */}
  <section class="block" id="proof">
    <SectionLabel code={no('proof')} title="Proof" variant="case" />
    <ProofBox figures={proofFigures} note={d.proof.note} />
    {d.perfTable && <PerfTable />}
  </section>

  {/* REFLECTION + NEXT */}
  <section class="block">
    <SectionLabel code={no('reflection')} title="Reflection" variant="case" />
    <ProseSection prose={d.reflection.prose} margin={d.reflection.margin} narrow />
    <div class="cs-next">
      <a class="row-nudge" href={csNext.href}>
        <div><div class="k">{csNext.kicker}</div><div class="t">{csNext.title}</div></div>
        <div class="arrow nudge-fixed">→</div>
      </a>
    </div>
  </section>
</Base>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + color */
  .cs-hero h1,
  .cs-next .t {
    font-family: var(--t-display-font); font-weight: var(--t-display-weight); letter-spacing: var(--t-display-track);
  }
  .cs-wall .cap,
  .cs-next .k {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }
  .cs-disclosure {
    font-family: var(--t-data-font); font-weight: var(--t-data-weight); letter-spacing: var(--t-data-track);
  }


  /* ===== SCOREBOARD HERO ===== */
  .cs-hero { padding: var(--space-4xl) 0 var(--space-3xl); }
  /* .badge / .badge-lg / in-house / agency / concept come from global.css */
  .cs-hero h1 { font-size: var(--fs-fluid-hero); line-height: var(--lh-display); margin: var(--space-lg) 0 0; }
  .cs-hero .descr { font-size: var(--fs-xl); line-height: var(--lh-copy); color: var(--text-secondary); max-width: var(--measure-lg); margin-top: var(--space-lg); }
  /* non-affiliation disclosure — a visible notice, not a footnote */
  .cs-disclosure { margin-top: var(--space-lg); padding: var(--space-sm) var(--space-md); border: 1px solid var(--border-strong); border-left: 2px solid var(--accent-fill); border-radius: var(--radius-sm); font-size: var(--fs-xs); line-height: var(--lh-copy); color: var(--text-secondary); max-width: var(--measure-xl); }
  .cs-wall { margin-top: var(--space-2xl); aspect-ratio: var(--ratio-wide); }
  .cs-wall video { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* the poster sits under the video and is removed once playback starts */
  /* The poster and caption fade out together with the play button when native controls take over — one gesture, all three on --dur-quick. `visibility` rather than `display` so opacity has something to animate; both sit under the video, so nothing is left interactive. */
  .cs-wall :global(.cs-poster) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 1; visibility: visible; transition: opacity var(--dur-quick) var(--ease-standard), visibility 0s; }
  .cs-wall .cap { position: absolute; left: 16px; bottom: 14px; font-size: var(--fs-2xs); text-transform: uppercase; color: var(--n-0); background: var(--scrim-chip); backdrop-filter: blur(6px); padding: var(--space-2xs) var(--space-sm); border-radius: var(--radius-none); opacity: 1; visibility: visible; transition: opacity var(--dur-quick) var(--ease-standard), visibility 0s; }
  /* the delay sits on the HIDDEN state so both return instantly when `ended` clears the flag — same pairing as .m-drawer */
  .cs-wall.is-playing :global(.cs-poster),
  .cs-wall.is-playing .cap { opacity: 0; visibility: hidden; transition: opacity var(--dur-quick) var(--ease-exit), visibility 0s var(--dur-quick); }

  /* ===== SECTIONS / PROSE / BODY ===== */
  /* .prose comes from global.css */
  /* ===== REFLECTION + NEXT ===== */
  .cs-next { border-top: 1px solid var(--border); margin-top: var(--space-3xl); }
  /* the hover nudge is .row-nudge in global.css — transform, not padding */
  .cs-next a { display: flex; align-items: center; justify-content: space-between; padding: var(--space-2xl) 0; gap: var(--space-lg); }
  .cs-next .k { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); }
  .cs-next .t { font-size: var(--fs-fluid-2xl); line-height: var(--lh-solid); margin-top: var(--space-sm); }
  /* Not a type tier: a single → glyph, so it takes the display family only. */
  .cs-next .arrow { font-family: var(--font-display); font-size: var(--fs-3xl); color: var(--accent-text); }

  /* ===== responsive ===== */
  @media (max-width: 900px) { .cs-hero { padding: var(--space-3xl) 0 var(--space-2xl); } }
</style>

<script>
  import { wireClickToPlay } from '../../scripts/motion';

  document.querySelectorAll('[data-cs-video]').forEach((wall) => {
    const video = wall.querySelector('video');
    const btn = wall.querySelector('.cs-video-play');
    if (video && btn) wireClickToPlay(wall, video, btn);
  });
</script>
