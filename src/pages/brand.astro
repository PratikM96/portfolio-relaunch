  .dont { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin-top: var(--space-xs); }
  /* surface comes from global .card */
  .dcard { padding: var(--space-lg); position: relative; min-height: 124px; display: flex; align-items: center; justify-content: center; }
  .dcard :global(.brandmark) { color: var(--text); }
  .x { position: absolute; top: 12px; left: 12px; width: 20px; height: 20px; border-radius: var(--radius-full); background: var(--danger); color: var(--n-0); font-size: var(--fs-xs); line-height: 20px; text-align: center; }
  .dwrap { display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); }
  .dlab { font-size: var(--fs-2xs); color: var(--text-secondary); text-align: center; line-height: 1.5; }
  /* The four "don't" demos below are deliberately off-system: an off-brand blue and a raw drop-shadow are the violation being shown. Tokens here would defeat the point. */
  .d-stretch :global(.brandmark) { transform: scaleX(1.7); }
  .d-recolor :global(.node) { fill: #2A4DFF; }
  .d-shadow :global(.brandmark) { filter: drop-shadow(3px 4px 3px rgba(0, 0, 0, .4)); }
  .d-rotate :global(.brandmark) { transform: rotate(15deg); }
  .d-onaccent { background: var(--accent-fill); padding: var(--space-md); border-radius: var(--radius-md); display: flex; }

  /* type — a spec table: one column per datum, so nothing wraps */
  .tyt { width: 100%; border-collapse: collapse; table-layout: auto; }
  .tyt th {
    text-transform: uppercase; font-size: var(--fs-3xs); color: var(--text-muted);
