  .logoset { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); margin-bottom: var(--space-md); }
  .tile { background: var(--n-0); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-xl); display: flex; align-items: center; justify-content: center; min-height: 140px; }
  .tile.dark { background: var(--n-950); border-color: var(--n-800); }
  .tile :global(.brandmark) { color: var(--n-950); }
  .tile.dark :global(.brandmark) { color: var(--n-50); }
  .lockrow { display: flex; align-items: center; gap: var(--space-md); }
  .lockcol { display: flex; flex-direction: column; align-items: center; gap: var(--space-sm); }
  /* Ink, because the tiles force their own paper background regardless of theme. */
  .wm { font-size: var(--fs-3xl); color: var(--n-950); }
  .tile.dark .wm { color: var(--n-50); }
