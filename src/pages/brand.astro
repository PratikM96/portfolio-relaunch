  @media (max-width: 560px) { .btoc { grid-template-columns: minmax(0, 1fr); } }

  /* motion — same three-column shape as the size and measure ladders above */
  .durs { margin-top: var(--space-md); }
  .d-row { display: grid; grid-template-columns: 200px minmax(0, 1fr) 240px; gap: var(--space-md); align-items: center; padding: var(--space-xs) 0; border-bottom: 1px solid var(--border); }
