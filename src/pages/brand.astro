  .p-b { font-size: var(--fs-sm); line-height: 1.55; margin-bottom: var(--space-md); }
  .p-pill { display: inline-block; font-size: var(--fs-3xs); padding: var(--space-xs) var(--space-sm); border-radius: var(--radius-sm); }

  /* layout */
  .s-row { display: flex; align-items: center; gap: var(--space-md); margin-bottom: var(--space-xs); }
  .s-lab { font-size: var(--fs-2xs); color: var(--text-secondary); width: 128px; flex-shrink: 0; }
  .s-bar { height: 14px; background: var(--accent-fill); border-radius: var(--radius-sm); }
  /* 12-column grid demo (matches the brand guidelines Layout section) */
