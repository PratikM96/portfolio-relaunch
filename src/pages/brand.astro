  .grid-demo { display: flex; gap: var(--space-xs); padding: 0 var(--space-lg); height: 96px; margin-top: var(--space-xl); }
  .gcol { flex: 1; background: color-mix(in srgb, var(--accent-fill) 10%, transparent); border-left: 1px solid var(--accent-fill); border-right: 1px solid var(--accent-fill); }
