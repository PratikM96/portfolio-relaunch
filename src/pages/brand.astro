  .r-row { display: flex; gap: var(--space-md); flex-wrap: wrap; }
  .r-box { width: 60px; height: 60px; background: var(--surface); border: 1.5px solid var(--text); }

  /* section index — the same [ 0N ] + uppercase-mono vocabulary as the headings it links to, so it reads as part of the system rather than as navigation bolted on. The 1px gap over a border-coloured background is the grid-line trick, not spacing, which is why it stays a literal. */
  .btoc {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px; background: var(--border); border: 1px solid var(--border);
    margin-top: var(--space-2xl);
  }
  .btoc-i {
    display: flex; align-items: baseline; gap: var(--space-sm);
