---
/**
 * Brand — the living brand reference. Rules transcribed from One-System-Brand-Guidelines v1.0 (Drive); voice comes from System Master.
 *
 * Token VALUES read live from tokens.css and `tokenValue` throws on a missing one. Everything else is hand maintained and can drift: prose, usage guidance, format mockups, and the §07 contrast ratios. Re-measure §07 when the ramp moves.
 */
import Base from '../layouts/Base.astro';
import CloseCTA from '../components/CloseCTA.astro';
import Brandmark from '../components/Brandmark.astro';
// Read as a raw string (Vite ?raw), not node:fs — this has to bundle for the Worker.
import tokensCss from '../styles/tokens.css?raw';

// Strip comments BEFORE the lookup: a comment explaining a token writes its name followed by a colon, which would match ahead of the real declaration.
const tokenSource = tokensCss.replace(/\/\*[\s\S]*?\*\//g, '');
const tokenValue = (name: string) => {
  const m = tokenSource.match(new RegExp(`${name}\\s*:\\s*([^;]+);`));
  if (!m) throw new Error(`/brand reads ${name}, which is not declared in tokens.css`);
  return m[1].trim();
};
const hex = (name: string) => tokenValue(name).replace('#', '').toUpperCase();
const px = (name: string) => tokenValue(name).replace('px', '');

// Live ramps + scales — every value is read from the token file.
const neutral = ['--n-0', '--n-50', '--n-100', '--n-200', '--n-300', '--n-400', '--n-500', '--n-550', '--n-600', '--n-700', '--n-800', '--n-900', '--n-950'];
const accent = ['--accent-50', '--accent-100', '--accent-200', '--accent-300', '--accent-400', '--accent-500', '--accent-600', '--accent-700', '--accent-800', '--accent-900'];
const spacing = [
  { token: '--space-xs', name: 'xs' }, { token: '--space-sm', name: 'sm' },
  { token: '--space-md', name: 'md' }, { token: '--space-lg', name: 'lg' },
  { token: '--space-xl', name: 'xl' }, { token: '--space-2xl', name: '2xl' },
  { token: '--space-3xl', name: '3xl' }, { token: '--space-4xl', name: '4xl' },
];
const radii = [
  { token: '--radius-none', name: 'none' }, { token: '--radius-sm', name: 'sm' },
  { token: '--radius-md', name: 'md', star: true }, { token: '--radius-lg', name: 'lg' },
  { token: '--radius-xl', name: 'xl' }, { token: '--radius-full', name: 'full' },
];
// The motion scale, read live like every other ladder on this page. Names say what the motion MEANS; the `for` column is the honest usage, so keep it true if a duration moves.
const durations = [
  { token: '--dur-instant', name: 'instant', for: 'the echo under a press' },
  { token: '--dur-quick', name: 'quick', for: 'colour, border, background, opacity', star: true },
  { token: '--dur-enter', name: 'enter', for: 'above-the-fold arrival (.rev-load)' },
  { token: '--dur-move', name: 'move', for: 'drawer, button lift, theme flip' },
  { token: '--dur-settle', name: 'settle', for: 'below-the-fold arrival (.rev), media scale' },
  { token: '--dur-ambient', name: 'ambient', for: 'the status dot, looping forever' },
];

const easings = [
  { token: '--ease-standard', name: 'standard', for: 'entrances and most moves', star: true },
  { token: '--ease-exit', name: 'exit', for: 'dismissals: drawer close, consent' },
  { token: '--ease-in-out', name: 'in-out', for: 'leaves AND arrives: theme, page transitions' },
];

// Distance and scale. `host` is the element SIZE each token really runs on, because these values are deliberately small and only read at their true scale: 1.03 on a 12px swatch is a third of a pixel, on a real card it is 5px. The token stays 1:1; the host is what makes it visible.
const travels = [
  { token: '--travel-xs', name: 'travel-xs', host: 'h-btn', for: 'the button lift' },
  { token: '--travel-sm', name: 'travel-sm', host: 'h-btn', for: 'reveal slide, row hover nudge' },
];
// Deliberately different hosts: the pair exists BECAUSE a 44px control needs more scale than a card to read as the same gesture, so showing both at their real size is the argument.
const scales = [
  { token: '--scale-hover', name: 'scale-hover', host: 'h-card', for: 'media hover: cards, tiles, stills' },
  { token: '--scale-control', name: 'scale-control', host: 'h-dot', for: 'small controls: the play button' },
];

// The size scale, read live like everything else on this page. A tier says which face; a step says how big.
const sizes = [
  { token: '--fs-3xs', name: '3xs', for: 'badges, rail keys' },
  { token: '--fs-2xs', name: '2xs', for: 'kickers, captions, chips' },
  { token: '--fs-xs', name: 'xs', for: 'rail nav, buttons' },
  { token: '--fs-sm', name: 'sm', for: 'card copy, secondary' },
  { token: '--fs-md', name: 'md', for: 'UI body, list copy' },
  { token: '--fs-base', name: 'base', for: 'document base', star: true },
  { token: '--fs-lg', name: 'lg', for: 'prose body' },
  { token: '--fs-xl', name: 'xl', for: 'h3, card titles, lead' },
  { token: '--fs-2xl', name: '2xl', for: 'sub-heads' },
  { token: '--fs-3xl', name: '3xl', for: 'large figures' },
  { token: '--fs-4xl', name: '4xl', for: 'the largest fixed figure' },
];

// The measure scale — a prose column's max-width, read live like the size scale above.
const measures = [
  { token: '--measure-3xs', name: '3xs', for: 'forced headline wrap: CTA' },
  { token: '--measure-2xs', name: '2xs', for: 'forced headline wrap: page h1' },
  { token: '--measure-xs', name: 'xs', for: 'short label / caption' },
  { token: '--measure-sm', name: 'sm', for: 'small aside copy' },
  { token: '--measure-md', name: 'md', for: 'compact card / meta copy' },
  { token: '--measure-lg', name: 'lg', for: 'lead paragraphs (.lead)' },
  { token: '--measure-xl', name: 'xl', for: 'disclosures, decisions, excerpts' },
  { token: '--measure-2xl', name: '2xl', for: 'long-form prose (.prose)' },
  { token: '--measure-3xl', name: '3xl', for: 'full-width article column' },
];

const stepOf = (t: string) => t.replace(/--(n|accent)-/, '');

/**
 * The nine sections, in page order. The index at the top and every section heading below render from this, so a renamed section cannot leave the index pointing at a title that no longer exists. `id` is the anchor; `t` is the full compound heading; the index shows only the part before the ` / `, which is the noun.
 */
const SECTIONS = [
  { id: 'foundation', n: '01', t: 'Foundation / the spine' },
  { id: 'logo', n: '02', t: 'Logo / the loop' },
  { id: 'type', n: '03', t: 'Type / three faces, one system' },
  { id: 'color', n: '04', t: 'Color / warm monochrome, one accent' },
  { id: 'layout', n: '05', t: 'Layout / a 4px base' },
  { id: 'motion', n: '06', t: 'Motion / functional, not decorative' },
  { id: 'contrast', n: '07', t: 'Colour contrast / checked against WCAG AA' },
  { id: 'formats', n: '08', t: 'Formats / the brand, in format' },
  { id: 'voice', n: '09', t: 'Voice / source: System Master' },
];
// Throws rather than rendering a blank heading, same contract as tokenValue above.
const sec = (id: string) => {
  const s = SECTIONS.find((x) => x.id === id);
  if (!s) throw new Error(`/brand references section "${id}", which is not in SECTIONS`);
  return s;
};
---

<Base
  image="/og/brand.png"
  title="Brand | One System | Pratik Mehta"
  description="One System is the design system this site runs on: foundation, logo, type, color, layout, motion, and access. Core token values render from the live CSS."
  activeNav="brand"
>
  <header class="bhero">
    <div class="page-kicker rev">[ Brand ] / One System / v1.0</div>
    <h1 class="rev page-h1">The brand,<br />built like a <span class="signal">product.</span></h1>
    <p class="lead rev">One System is the identity this site runs on: foundation, logo, type, color, layout, motion, and access, in one place. It is a working reference and a case study of the thinking behind it. Core token values render from the live CSS, so the numbers below are the real ones; the usage guidance and examples are maintained alongside them.</p>
    {/* The index and the headings below share one source, so a renamed section can't leave a dead label here. Only the noun shows: the gloss after the ` / ` is context for the section, not a name to scan. */}
    <nav class="btoc rev" aria-label="Sections">
      {SECTIONS.map((s) => (
        <a class="btoc-i" href={`#${s.id}`}>
          <span class="n">[ {s.n} ]</span>
          <span class="t">{s.t.split(' / ')[0]}</span>
        </a>
      ))}
    </nav>
  </header>

  {/* 01 FOUNDATION */}
  <section class="bsec" id={sec('foundation').id}>
    <div class="blabel"><span class="c">[ {sec('foundation').n} ]</span><h2 class="t">{sec('foundation').t}</h2><span class="rule"></span></div>
    <p class="intro">Creative built like a system and accountable to what it does after it ships. The breadth is the proof of the idea, not a separate selling point.</p>
    <div class="frow" style="border-top:none">
      <div class="fspec">tagline</div>
      <div class="fsamp tagline">One system, end to end<span class="signal">.</span></div>
    </div>
    <div class="frow"><div class="fspec">reserve line</div><div class="fsamp">Built, not briefed.</div></div>
    <div class="frow"><div class="fspec">accent signal</div><div class="fsamp mono">Signal orange / #{hex('--accent-500')} / used once, to do one job</div></div>
  </section>

  {/* 02 LOGO */}
  <section class="bsec" id={sec('logo').id}>
    <div class="blabel"><span class="c">[ {sec('logo').n} ]</span><h2 class="t">{sec('logo').t}</h2><span class="rule"></span></div>
    <p class="intro">One continuous stroke that closes on the orange node: the system, end to end, as a mark. Default to the primary lockup. The wordmark carries the circular period; the lockups don't.</p>
    {/* Specimen sizes below are literal on purpose: these show the mark and wordmark at chosen physical sizes, the way `Brandmark size={52}` does. They are not UI type, so they don't compose the --fs-* scale. */}
    <div class="logoset rev">
      <div class="tile"><div class="lockrow"><Brandmark size={52} title={undefined} /><span class="wm">Pratik Mehta</span></div></div>
      <div class="tile dark"><div class="lockrow"><Brandmark size={52} title={undefined} /><span class="wm">Pratik Mehta</span></div></div>
      <div class="tile"><div class="lockcol"><Brandmark size={44} title={undefined} /><span class="wm" style="font-size:24px">Pratik Mehta</span></div></div>
      <div class="tile"><span class="wm" style="font-size:31px">Pratik Mehta<span class="period"></span></span></div>
    </div>
    <div class="cap">primary (ink or paper), stacked, and wordmark with period. Use the mono mark where the accent can't appear.</div>

    <div class="subhead">Clear space &amp; minimum size</div>
    <div class="clearrow">
      <div><div class="csbox"><Brandmark size={72} title={undefined} /></div><div class="cap">keep-out = 0.25 × mark height</div></div>
      <div class="mincol"><Brandmark size={24} title={undefined} /><div class="cap">mark / 24px floor</div></div>
      <div class="mincol"><Brandmark size={16} title={undefined} /><div class="cap">favicon cut / 16px</div></div>
    </div>

    <div class="subhead">Never do this</div>
    <div class="dont rev">
      <div class="card dcard"><span class="x">✕</span><div class="dwrap"><div class="d-stretch"><Brandmark size={52} title={undefined} /></div><span class="dlab">stretch or distort</span></div></div>
      <div class="card dcard"><span class="x">✕</span><div class="dwrap"><div class="d-recolor"><Brandmark size={52} title={undefined} /></div><span class="dlab">recolor the node</span></div></div>
      <div class="card dcard"><span class="x">✕</span><div class="dwrap"><span class="wm" style="font-size:24px">Pratik Mehta<span class="period sq"></span></span><span class="dlab">square the period</span></div></div>
      <div class="card dcard"><span class="x">✕</span><div class="dwrap"><div class="d-shadow"><Brandmark size={52} title={undefined} /></div><span class="dlab">add effects</span></div></div>
      <div class="card dcard"><span class="x">✕</span><div class="dwrap"><div class="d-rotate"><Brandmark size={52} title={undefined} /></div><span class="dlab">rotate or tilt</span></div></div>
      <div class="card dcard"><span class="x">✕</span><div class="dwrap"><div class="d-onaccent"><Brandmark size={40} title={undefined} /></div><span class="dlab">accent node on orange</span></div></div>
    </div>
  </section>

  {/* 03 TYPE */}
  <section class="bsec" id={sec('type').id}>
    <div class="blabel"><span class="c">[ {sec('type').n} ]</span><h2 class="t">{sec('type').t}</h2><span class="rule"></span></div>
    <p class="intro">Each face has one job. Clash Display is the voice: display, h1, h2. Clash Grotesk is reading type: sub-headings and body. JetBrains Mono is the system layer: labels, data, and code. All three ship as one variable file per family, so every weight below is real rather than the nearest available one.</p>
    <p class="intro">Tracking is optical, not decorative. It tightens as type gets bigger, sits at zero for reading, and opens up for uppercase mono. Mono labels and emphasis are always uppercase, because heavy tracking is an uppercase device and breaks apart on lowercase; sentence-case mono is the data tier at +5% instead.</p>
    {/* One column per datum so nothing wraps mid-font-name. Every sample is a REAL use of that tier on this site — the samples are the proof. Keep the `where` column honest if a tier moves. */}
    <table class="tyt">
      <thead>
        <tr><th>tier</th><th>face</th><th>wt</th><th>track</th><th>where</th><th class="s">sample</th></tr>
      </thead>
      <tbody>
        <tr>
          <td class="tier">display</td><td class="meta">Clash Display</td><td class="meta">700</td><td class="meta">-2%</td>
          <td class="meta">every page head, closing CTA, stat figures</td>
          <td class="s"><span class="v disp" style="font-size:var(--fs-fluid-2xl)">One system<span class="signal">.</span></span></td>
        </tr>
        <tr>
          <td class="tier">h1</td><td class="meta">Clash Display</td><td class="meta">600</td><td class="meta">-1%</td>
          <td class="meta">the wordmark lockup</td>
          <td class="s"><span class="v t-h1" style="font-size:var(--fs-2xl)">Pratik Mehta</span></td>
        </tr>
        <tr>
          <td class="tier">h2</td><td class="meta">Clash Display</td><td class="meta">500</td><td class="meta">-1%</td>
          <td class="meta">section heads, journal lead post, mobile nav</td>
          <td class="s"><span class="v t-h2" style="font-size:var(--fs-2xl)">Engineer turned creative.</span></td>
        </tr>
        <tr>
          <td class="tier">h3-h6</td><td class="meta">Clash Grotesk</td><td class="meta">500</td><td class="meta">0%</td>
          <td class="meta">card titles, index rows, sub-heads</td>
          <td class="s"><span class="v t-h3" style="font-size:var(--fs-xl)">SPORTIME Clubs</span></td>
        </tr>
        <tr>
          <td class="tier">body</td><td class="meta">Clash Grotesk</td><td class="meta">400</td><td class="meta">0%</td>
          <td class="meta">copy / lh 1.65 / <strong style="font-weight:600;color:var(--text-secondary)">strong</strong> = 600</td>
          <td class="s"><span class="v t-body" style="font-size:var(--fs-md);line-height:1.6;color:var(--text-secondary)">The work stays coherent and the loop closes.</span></td>
        </tr>
        <tr>
          <td class="tier">label</td><td class="meta">JetBrains Mono</td><td class="meta">400</td><td class="meta">+10%</td>
          <td class="meta">kickers, badges, section labels / always uppercase</td>
          <td class="s"><span class="v t-label" style="font-size:var(--fs-2xs);color:var(--text-secondary)">Brand / Social / Performance</span></td>
        </tr>
        <tr>
          <td class="tier">data / nav</td><td class="meta">JetBrains Mono</td><td class="meta">400</td><td class="meta">+5%</td>
          <td class="meta">rail nav, scoreboard values, the clock / sentence case</td>
          <td class="s"><span class="v t-data" style="font-size:var(--fs-sm);color:var(--text-secondary)">Home &nbsp;/&nbsp; 2023-2024 &nbsp;/&nbsp; 12:53 PM</span></td>
        </tr>
        <tr>
          <td class="tier">emphasis</td><td class="meta">JetBrains Mono</td><td class="meta">600</td><td class="meta">+10%</td>
          <td class="meta">buttons / always uppercase</td>
          <td class="s"><span class="v t-emphasis" style="font-size:var(--fs-2xs)">View work</span></td>
        </tr>
      </tbody>
    </table>

    <div class="subhead">Size / eleven steps</div>
    <p class="intro">A tier says which face. A step says how big. Every size on the site is one of these, so a rule never writes a pixel value. The steps sit where the design already clustered rather than on a ratio, which is why they crowd at the small end: most of the system is labels and captions.</p>
    <div class="sizes">
      {sizes.map((s) => (
        <div class="z-row">
          <div class="z-lab">{s.name}{s.star ? ' ★' : ''} / {tokenValue(s.token)}</div>
          <div class="z-samp" style={`font-size: var(${s.token})`}>One system, end to end.</div>
          <div class="z-for">{s.for}</div>
        </div>
      ))}
    </div>
    <div class="mono muted gridnote">plus <code>--fs-fluid-*</code> for type that scales with the viewport. Container-query sizing stays per-component.</div>

    <div class="subhead">Measure / nine steps</div>
    <p class="intro">A prose column's max-width, capped for reading comfort rather than let run to the edge of its box. Same sample at every step, so the wrap itself is the demonstration. <code>lg</code> and <code>2xl</code> are the two anchors, <code>.lead</code> and <code>.prose</code>; everything else was picked around them.</p>
    <div class="measures">
      {measures.map((m) => (
        <div class="m-row">
          <div class="z-lab">{m.name} / {tokenValue(m.token)}</div>
          <div class="m-samp" style={`max-width: var(${m.token})`}>Creative built like a system and accountable to what it does after it ships. The breadth is the proof of the idea, not a separate selling point.</div>
          <div class="z-for">{m.for}</div>
        </div>
      ))}
    </div>
  </section>

  {/* 04 COLOR */}
  <section class="bsec" id={sec('color').id}>
    <div class="blabel"><span class="c">[ {sec('color').n} ]</span><h2 class="t">{sec('color').t}</h2><span class="rule"></span></div>
    <p class="intro">A warm neutral ramp from paper to ink, a single signal-orange accent, and a restrained state set. Both light and dark are first-class.</p>
    <div class="subhead">Neutral / warm ramp</div>
    <div class="ramp">
      {neutral.map((t) => (
        <div class="chip"><div class="sw" style={`background: var(${t})`}></div><div class="hx">{stepOf(t)}<br />{hex(t)}</div></div>
      ))}
    </div>
    <div class="subhead">Accent / signal orange <span class="signal">★ 500</span></div>
    <div class="ramp">
      {accent.map((t) => (
        <div class="chip"><div class="sw" style={`background: var(${t});${t === '--accent-500' ? ' outline:2px solid var(--text); outline-offset:1px;' : ''}`}></div><div class="hx">{stepOf(t)}{t === '--accent-500' ? '★' : ''}<br />{hex(t)}</div></div>
      ))}
    </div>
    <div class="subhead">Surfaces / light &amp; dark</div>
    <div class="panels">
      <div class="panel" style="background:var(--n-50)"><div class="p-lab" style="color:var(--n-550)">light / paper</div><div class="p-h" style="color:var(--n-950)">One system<span style="color:var(--accent-500)">.</span></div><div class="p-b" style="color:var(--n-600)">Body in graphite on paper. The accent does one job.</div><span class="p-pill" style="background:var(--accent-50);color:var(--accent-800)">brand / social / perf</span></div>
      <div class="panel" style="background:var(--n-950);border-color:var(--n-800)"><div class="p-lab" style="color:var(--n-400)">dark / ink</div><div class="p-h" style="color:var(--n-50)">One system<span style="color:var(--accent-500)">.</span></div><div class="p-b" style="color:var(--n-400)">Same system inverted. Orange stays the single accent.</div><span class="p-pill" style="background:var(--n-800);color:var(--accent-400)">brand / social / perf</span></div>
    </div>
  </section>

  {/* 05 LAYOUT */}
  <section class="bsec" id={sec('layout').id}>
    <div class="blabel"><span class="c">[ {sec('layout').n} ]</span><h2 class="t">{sec('layout').t}</h2><span class="rule"></span></div>
    <p class="intro">Everything measures from a 4px unit. Layout is a {px('--grid-cols')}-column grid, max-width {px('--grid-max-width')}, {px('--grid-gutter')} gutters, {px('--grid-margin')} margins. Radius base is {px('--radius-md')}px; the mono system layer uses sharp 0 corners.</p>
    <div class="scale">
      {spacing.map((s) => (
        <div class="s-row"><div class="s-lab">{s.name} / {tokenValue(s.token)}</div><div class="s-bar" style={`width: var(${s.token})`}></div></div>
      ))}
    </div>
    <div class="card grid-demo" aria-hidden="true">{Array.from({ length: 12 }).map(() => (<div class="gcol"></div>))}</div>
    <div class="mono muted gridnote">{px('--grid-cols')} columns / max {px('--grid-max-width')} / gutter {px('--grid-gutter')} / margin {px('--grid-margin')}</div>
    <div class="subhead" style="margin-top:var(--space-xl)">Radius</div>
    <div class="r-row">
      {radii.map((r) => (
        <div><div class="r-box" style={`border-radius: var(${r.token})`}></div><div class="hx">{r.name}{r.star ? ' ★' : ''} / {r.name === 'full' ? 'pill' : px(r.token)}</div></div>
      ))}
    </div>
  </section>

  {/* 06 MOTION — every demo below is driven by the token it documents, so a bar cannot claim one duration while animating another. Hover a row to replay it. */}
  <section class="bsec" id={sec('motion').id}>
    <div class="blabel"><span class="c">[ {sec('motion').n} ]</span><h2 class="t">{sec('motion').t}</h2><span class="rule"></span></div>
    <p class="intro">Quick and confident. Short travel, no bounce. The names say what a motion <em>means</em>, not how fast it is, so a rule picks by intent: a colour swap is <code>quick</code> wherever it sits, a slide is <code>move</code> whatever the distance. Reels inherit this: cuts over fades, snap transitions.</p>

    <div class="subhead">Duration / six steps</div>
    <p class="intro">Every <code>transition</code> and <code>animation</code> on the site composes one of these. <code>quick</code> is the anchor and carries most of it. Hover a row to play it at its real duration.</p>
    <div class="durs">
      {durations.map((d) => (
        <div class="d-row">
          <div class="z-lab">{d.name}{d.star ? ' ★' : ''} / {tokenValue(d.token)}</div>
          <div class="d-track"><span class="d-dot" style={`transition-duration: var(${d.token})`}></span></div>
          <div class="z-for">{d.for}</div>
        </div>
      ))}
    </div>

    <div class="subhead">Easing / three curves</div>
    <p class="intro">Same distance, same duration, different curve. Each one has a job: an entrance and a dismissal should not feel alike, and a move that leaves and arrives wants a curve that eases at both ends.</p>
    <div class="durs">
      {easings.map((e) => (
        <div class="d-row">
          <div class="z-lab">{e.name}{e.star ? ' ★' : ''}</div>
          <div class="d-track"><span class="d-dot" style={`transition-duration: var(--dur-settle); transition-timing-function: var(${e.token})`}></span></div>
          <div class="z-for">{e.for}</div>
        </div>
      ))}
    </div>
    <div class="mono muted gridnote">{easings.map((e) => `${e.name} ${tokenValue(e.token)}`).join('   /   ')}</div>

    <div class="subhead">Distance and scale</div>
    <p class="intro">A transform's magnitude is a token too, or three hover scales drift apart the way they had. These values are small on purpose, so each one runs on the size of element it actually moves: the dashed outline is where the shape rests, and hovering separates it by exactly one token. The two scales are a pair rather than a ladder, which is why the card and the control are shown at their own sizes.</p>
    <div class="durs">
      {travels.map((t) => (
        <div class="d-row">
          <div class="z-lab">{t.name} / {tokenValue(t.token)}</div>
          <div class="d-stage">
            <span class:list={['d-ghost', t.host]}></span>
            <span class:list={['d-host', 'lift', t.host]} style={`--to: var(${t.token})`}></span>
          </div>
          <div class="z-for">{t.for}</div>
        </div>
      ))}
      {scales.map((s) => (
        <div class="d-row">
          <div class="z-lab">{s.name} / {tokenValue(s.token)}</div>
          <div class="d-stage">
            <span class:list={['d-ghost', s.host]}></span>
            <span class:list={['d-host', 'grow', s.host]} style={`--to: var(${s.token})`}></span>
          </div>
          <div class="z-for">{s.for}</div>
        </div>
      ))}
    </div>
    <div class="mono muted gridnote">plus <code>--stagger-step</code> ({tokenValue('--stagger-step')}), the per-item delay in a staggered list reveal.</div>

    <div class="subhead">Reduced motion</div>
    <p class="intro">Here "reduce" means <em>remove</em>. Killing the tween alone still lets a hover end-state apply, so a card would jump 3% larger in a single frame, and a snap is still movement. Under <code>prefers-reduced-motion</code> every transition and animation is off, nothing translates or scales, page transitions are cancelled, and smooth scrolling reverts to instant. Hover stays legible on colour and border alone. Video is gated in JavaScript, since CSS cannot stop playback. The swatches in this section follow the same rule: they hold still, and the printed values carry it.</p>
  </section>

