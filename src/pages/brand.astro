  .bsec { padding: var(--space-4xl) 0; }
  .bsec .intro { font-size: var(--fs-base); line-height: 1.6; color: var(--text-secondary); max-width: var(--measure-xl); margin-bottom: var(--space-xl); }
  .subhead { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); margin: var(--space-2xl) 0 var(--space-md); }
  .cap { font-size: var(--fs-2xs); color: var(--text-muted); margin-top: var(--space-sm); line-height: 1.5; }
  /* version + review stamp under the page lead */
  .muted { color: var(--text-muted); }

  /* foundation */
  .frow { display: flex; align-items: baseline; gap: var(--space-lg); padding: var(--space-md) 0; border-top: 1px solid var(--border); flex-wrap: wrap; }
  .fspec { font-size: var(--fs-2xs); color: var(--text-muted); width: 200px; flex-shrink: 0; }
  .fsamp { flex: 1; min-width: 240px; color: var(--text); font-size: var(--fs-base); }
