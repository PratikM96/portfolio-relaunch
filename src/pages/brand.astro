  .sizes { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .z-row {
    display: grid; grid-template-columns: 132px 1fr 200px; gap: var(--space-md);
    align-items: baseline; padding: var(--space-sm) 0; border-bottom: 1px solid var(--border);
  }
  .z-lab { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--accent-text); white-space: nowrap; }
  .z-samp { color: var(--text); line-height: 1.3; min-width: 0; }
  .z-for { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); text-align: right; }
  @media (max-width: 900px) {
    .z-row { grid-template-columns: 96px 1fr; }
    .z-for { display: none; }
  }

  /* measure scale — one row per step, same sample text clipped to the real token so the wrap demonstrates it */
  .measures { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .m-row {
    display: grid; grid-template-columns: 132px 1fr 200px; gap: var(--space-md);
    align-items: start; padding: var(--space-md) 0; border-bottom: 1px solid var(--border);
  }
  .m-samp { font-size: var(--fs-sm); line-height: 1.5; color: var(--text-secondary); border: 1px dashed var(--border-strong); border-radius: var(--radius-sm); padding: var(--space-sm); }
  @media (max-width: 900px) {
    .m-row { grid-template-columns: 96px 1fr; }
    .m-row .z-for { display: none; }
  }

  /* Narrow: shed columns in order of what the table is for. `where` goes first, then `track` — the tracking values are documented in the prose above and in tokens.css, so the tier/face/sample triple is what has to survive. */
  @media (max-width: 1100px) { .tyt th:nth-child(5), .tyt td:nth-child(5) { display: none; } }
  @media (max-width: 560px) {
    .tyt th:nth-child(4), .tyt td:nth-child(4) { display: none; }
    /* Every remaining nowrap has to go, or the table sets a min-content width
       wider than the page: "Clash Display" and "data / nav" both stack instead. */
    .tyt th:nth-child(2), .tyt td:nth-child(2) { white-space: normal; }
    .tyt .tier { white-space: normal; }
    .tyt th, .tyt td { padding-right: var(--space-sm); }
