---
/**
 * Home. Chrome (rail, footer, theme, fonts) lives in Base.astro; hero, bento,
 * modules, journal and close stay inline here.
 */
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import headshot from '../assets/headshot-4x5.jpg';
import heroPosterSrc from '../assets/hero/home/poster.webp';
import { sizesForSplit } from '../lib/layout';
import SectionLabel from '../components/SectionLabel.astro';
import DisciplineStrip from '../components/DisciplineStrip.astro';
import WorkIndex from '../components/WorkIndex.astro';
import StatFigure from '../components/StatFigure.astro';
import CloseCTA from '../components/CloseCTA.astro';
import { publishedJournal, formatDate } from '../lib/content';
import { cardPosters } from '../lib/media';
import { TYPE_LABEL } from '../lib/work-type';

const allWork = await getCollection('work');
const bySlug = new Map(allWork.map((e) => [e.data.slug, e]));
const pick = (slug: string) => {
  const e = bySlug.get(slug);
  if (!e) throw new Error(`Home page references "${slug}", which is not in the work collection`);
  return e.data;
};

// "Selected work" — curated, minus the four featured cards above it.
const SELECTED = ['raa', 'frc', 'agency-fiveeighty', 'level', 'wisp'];
const selectedWork = SELECTED.map((s) => bySlug.get(s)).filter((e) => e !== undefined);

/**
 * The four featured cards. Slug, type label and disciplines come from the entry; only the
 * blurb is home-page copy, deliberately shorter than the case-study lede.
 *
 * Order carries the evidence hierarchy: the two paid roles first, then the self-initiated
 * work. The first two must match the `featured: true` entries, or / and /work disagree
 * about what the featured pair is.
 */
const BENTO: { slug: string; blurb: string }[] = [
  { slug: 'sportime-clubs', blurb: 'A video-first content engine across tennis, pickleball, and a $75M expansion. 11.7M cross-platform impressions in a year.' },
  { slug: 'dealnews', blurb: 'Social, paid, and in-house design run as one function, so creative decisions and performance feedback stayed in the same hands.' },
  { slug: 'portfolio-system', blurb: 'This site, built as one system and measured on itself: 100 desktop Lighthouse on every page, re-run on every change.' },
  { slug: 'the-ninth', blurb: 'A self-initiated esports membership concept, brand through product, with an AI moment-clipper prototype at the center.' },
];
const bento = await Promise.all(BENTO.map(async ({ slug, blurb }) => {
  const d = pick(slug);
  // Both hashed poster URLs, because card-video.ts cannot derive a hashed path at runtime.
  return { slug, blurb, title: d.title, type: d.type, disciplines: d.disciplines, poster: await cardPosters(slug) };
}));

// Journal teaser — three most recent published posts.
const journalPosts = publishedJournal(await getCollection('journal')).slice(0, 3);

/**
 * Hero poster. Unlike the eight case-study heroes this one is BOTH the LCP element and the still that reduced-motion / save-data visitors see instead of the animation, so it goes through the image pipeline (hashed, responsive) rather than shipping verbatim from public/. One getImage() call feeds the <img> and Base's preload so the two cannot resolve to different candidates and fetch it twice.
 *
 * The slot is derived, not guessed: nothing in the chain sets a max-width, so above the rail breakpoint the figure is 0.45 of the content column and keeps growing with the viewport (652px at 1920, ~950px at 2560). Below it the row stacks and the figure is the full column, which sizesForSplit falls through to.
 */
const HERO_POSTER_SIZES = sizesForSplit(0.45);
/* The 1100 step is deliberate and load-bearing: Lighthouse's mobile emulation is 412px at DPR 2.625, which asks for 1081 device px, so a ladder that jumps 1080 -> 1440 there hands the LCP element ~16KB instead of ~10KB. 1440 exists for retina desktop, where the slot reaches 1300px+ and there is LCP headroom to spend. */
const heroPoster = await getImage({
  src: heroPosterSrc,
  widths: [480, 800, 1100, 1440],
  width: 1440,
  sizes: HERO_POSTER_SIZES,
  format: 'webp',
});

---

<Base
  title="Pratik Mehta | Creative Marketing Lead"
  description="I build creative, social, and performance as one system. Creative Marketing Lead in New York, with an AI-forward workflow."
  preloadImage={heroPoster.src}
  preloadImageSrcset={heroPoster.srcSet.attribute}
  preloadImageSizes={HERO_POSTER_SIZES}
>
  {/* SPLIT HERO */}
  <section class="hero">
    <div class="hero-inner">
      <div>
        {/* Two lines, never joined by a separator: a `/` between them reads as "roles in
            New York", which is not the scope. Location leads, availability follows. */}
        <div class="kick rev-load">Based in New York<br />Open to creative or marketing roles</div>
        <h1 class="rev-load page-h1">I build creative, social, and performance as <span class="signal">one system.</span></h1>
        {/* Must not open with "I build" or repeat "system": the h1 does both, and its
            accent lands on "one system." */}
        <p class="lead rev-load">I own the whole arc: concept, production, the channels it runs in, and the reporting that decides what gets made next.</p>
        <div class="btn-row rev-load"><a class="btn btn-p" href="/work">View work →</a><a class="btn btn-g" href="/contact">Get in touch →</a></div>
      </div>
      <figure class="hero-figure rev-load">
        {/* 1:1 brand-mark animation; JS hook is data-hero-video. */}
        <div class="frame">
          <button class="hero-video" type="button" data-hero-video
            aria-label="Play or pause the intro animation" aria-pressed="true">
            {/* A real <img>, not the video's `poster` attribute, so it gets a responsive srcset. It sits OVER the video and is dropped on the first `playing` event: if the script never runs the video never plays either, so the still staying put is the right failure, which is not true of hiding it behind a <video> that has not decoded a frame. alt="" because the button above already names this control. */}
            <img
              class="hero-poster"
              src={heroPoster.src}
              srcset={heroPoster.srcSet.attribute}
              sizes={HERO_POSTER_SIZES}
              width="900" height="900"
              alt=""
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <video
              width="900" height="900"
              muted loop playsinline preload="none"
            >
              {/* Versioned filename, NOT bytes swapped in place: /hero/* is immutable for a year in public/_headers, so a re-cut only reaches returning visitors under a new URL. Bump to -v3 on the next one. */}
              <source src="/hero/home/hero_900-v2.webm" type="video/webm" />
            </video>
            <span class="hero-video-state" aria-hidden="true">❚❚ Pause</span>
          </button>
        </div>
      </figure>
    </div>
  </section>

  {/* DISCIPLINES STRIP */}
  <DisciplineStrip />

  {/* BENTO — featured */}
  <section class="block" id="featured">
    <SectionLabel code="01" title="Featured" />
    {/* The reveal moved from this wrapper onto the cards so the row builds left to right rather than arriving as one slab. --rev-i is the item's place in the stagger; global.css turns it into a delay. */}
    <div class="bento">
      <div class="feat-row">
        {bento.map((p, i) => (
          <a class="card card--interactive t-feat rev" style={`--rev-i:${i}`} href={`/work/${p.slug}`}>
            <span class:list={['badge', p.type]}>{TYPE_LABEL[p.type]}</span>
            <div class="img">
              {/* Neither a <source> nor a `poster` in the markup. card-video.ts adds the source on first hover and the poster ~300px before the card scrolls in, so a card the visitor never reaches costs nothing: all four of these sit below the fold on a phone, and a `poster` attribute fetches the instant it exists. */}
              <video class="tile-video" muted loop playsinline preload="none" data-slug={p.slug} data-poster={p.poster.dark} data-poster-light={p.poster.light}></video>
            </div>
            <div class="meta">
              <div>
                <h3 class="h3">{p.title}</h3>
                <p>{p.blurb}</p>
              </div>
              <div class="disc">
                {p.disciplines.map((d, i) => (
                  <Fragment>{i > 0 && <br />}{d}{i < p.disciplines.length - 1 ? ' /' : ''}</Fragment>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
      {/* Practice-level career totals, never case-study numbers. Values and labels are the
          Claim Registry's public wording verbatim, and /resume renders the same strings:
          "10K+" was a variant of "10,000+" and drifted from it. */}
      <div class="stat-row">
        <div class="card card--interactive t-stat rev" style="--rev-i:0"><div class="fig"><StatFigure value="10+" /></div><div class="lab">years of cross-channel experience</div></div>
        <div class="card card--interactive t-stat rev" style="--rev-i:1"><div class="fig"><StatFigure value="20+" /></div><div class="lab">brands, partners, and organizations</div></div>
        <div class="card card--interactive t-stat rev" style="--rev-i:2"><div class="fig"><StatFigure value="75+" /></div><div class="lab">campaigns launched</div></div>
        <div class="card card--interactive t-stat rev" style="--rev-i:3"><div class="fig"><StatFigure value="10,000+" /></div><div class="lab">design assets produced</div></div>
      </div>
    </div>
  </section>

  {/* WORK INDEX */}
  <section class="block" id="work">
    <SectionLabel code="02" title="Selected work" more={{ href: '/work', label: 'View all →' }} />
    {/* No filter bar: five curated, labeled entries. The full facet set is on /work. */}
    <WorkIndex entries={selectedWork} filters={false} />
  </section>


  {/* MODULES */}
  <section class="block">
    <SectionLabel code="03" title="The practice" />
    <div class="duo">
      <a class="card card--interactive mod rev" id="brand" href="/brand">
        <div class="k">One System / brand</div>
        <h3 class="h2">One system, end to end.</h3>
        <p>The brand, the work, and the thinking run on the same logic: built like a system, accountable to what it does after it ships.</p>
        <span class="go">See the brand system →</span>
      </a>
      <a class="card card--interactive mod mod-about rev" id="about" href="/about">
        {/* A fixed 160px box (140 below BP.sm), so the slot is a literal rather than shell-derived: this is the one place a px `sizes` is honest. */}
        <div class="face"><Image src={headshot} alt="Pratik Mehta" widths={[160, 320, 480]} sizes="(max-width: 560px) 140px, 160px" format="webp" /></div>
        <div class="about-body">
          <div class="k">About</div>
          <h3 class="h2">Engineer turned creative.</h3>
          <p>I started in computer science and kept moving toward the people the work is actually for, through design into marketing. Now I build creative, social, and performance as one connected system.</p>
          <span class="go">More about the practice →</span>
        </div>
      </a>
    </div>
  </section>

  {/* JOURNAL */}
  <section class="block" id="journal">
    <SectionLabel
      code="04"
      title="Journal"
      more={journalPosts.length > 0 ? { href: '/journal', label: 'View all →' } : undefined}
    />
    {
      journalPosts.length === 0 ? (
        <div class="card jr-empty rev">
          <span class="jr-tag">[ Coming soon ]</span>
          <p>Notes on systems, brand, and AI. The first posts go up after launch.</p>
        </div>
      ) : (
        <div class="jr-list">
          {journalPosts.map((p, i) => (
            <a class="jr-row row-nudge rev" style={`--rev-i:${i}`} href={`/journal/${p.id}`}>
              <div class="jr-text">
                <div class="jr-t">{p.data.title}</div>
                <div class="jr-ex">{p.data.excerpt}</div>
              </div>
              <div class="jr-m nudge-fixed">
                {[p.data.topic, formatDate(p.data.date), p.data.readingTime].filter(Boolean).join(' / ')}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </section>

  {/* Hero animation: loop + pause off-screen + click-to-toggle + reduced-motion */}
  <script>
    import { prefersReducedMotion, observeInView, onReducedMotionChange } from '../scripts/motion';
    (function () {
      const btn = document.querySelector('[data-hero-video]');
      if (!btn) return;
      const video = btn.querySelector('video');
      if (!video) return;
      var chip = btn.querySelector('.hero-video-state');
      var userPaused = false; // explicit click choice — overrides auto-resume
      var inView = true;
      var ready = false; // gate playback until after load (see start() below)

      const sync = function () {
        var playing = !video.paused;
        btn.setAttribute('aria-pressed', String(playing));
        if (chip) chip.textContent = playing ? '❚❚ Pause' : '▶ Play';
      };
      const autoPlay = function () {
        if (!ready || userPaused || prefersReducedMotion() || !inView) return;
        var p = video.play(); // preload="none" → play() triggers the fetch
        if (p && p.catch) p.catch(function () {});
      };

      // Deferred in three stages, because the FETCH was never the expensive part.
      //
      // `load` alone let the ~1.1MB fetch land inside the LCP/Speed Index window, which is what the idle callback was added for. The decode is the newer problem: this animation carries newspaper halftone, a photographic globe and film grain across 240 frames, so it costs far more main thread than the flat mark it replaced at the same byte weight. Starting it while the page is still settling put that cost inside the interactive window.
      //
      // Nothing here is above-the-fold work. The poster is preloaded and already painted, and it is the resolved lockup rather than a mid-animation frame, so the hero looks finished before the loop ever runs. Holding the loop back costs the visitor nothing and costs the main thread everything it was spending.
      //
      // A metered or slow link never auto-starts at all (the poster is the whole experience there); a click always starts it, ungated. The Network Information API is Chromium-only, so every read is guarded.
      var conn = (navigator as any).connection;
      var frugal = !!conn && (conn.saveData === true || /^((slow-)?2g|3g)$/.test(conn.effectiveType || ''));
      // The shim ignores the `{ timeout }` it is handed below, which is correct rather than a dropped argument: it fires at a fixed delay that already sits inside the deadline that option exists to enforce. Declaring the parameter just to discard it only buys an unused-variable warning.
      var idle = (window as any).requestIdleCallback || function (cb: () => void) { return setTimeout(cb, 1200); };
      // Stage 2: a beat after `load`, so the decode is not competing with whatever the page is still finishing. Stage 3: genuine main-thread idle, with a ceiling high enough that a busy thread is waited out rather than interrupted.
      var HOLD_MS = 1200;
      var begin = function () {
        // A hidden tab decodes nothing. Someone who opens the site in a background tab keeps the poster until they actually look at it, and `visibilitychange` below is the resume.
        if (document.visibilityState !== 'visible') return;
        idle(function () { ready = true; autoPlay(); }, { timeout: 4000 });
      };
      var arm = function () { setTimeout(begin, HOLD_MS); };
      if (prefersReducedMotion() || frugal) {
        video.pause();
      } else {
        if (document.readyState === 'complete') arm();
        else window.addEventListener('load', arm, { once: true });
        // `!ready` keeps this a no-op once the loop has started, so it cannot double-start
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'visible' && !ready) begin();
        });
      }

      // pause off-screen, resume when back — shared threshold, shared observer shape
      observeInView(btn, function (visible) {
        inView = visible;
        if (inView) autoPlay(); else video.pause();
      });

      // a mid-session opt-in stops the hero without needing a reload
      onReducedMotionChange(function (reduce) { if (reduce) video.pause(); });

      // click anywhere on the video toggles play/pause
      btn.addEventListener('click', function () {
        if (video.paused) { userPaused = false; var p = video.play(); if (p && p.catch) p.catch(function () {}); }
        else { userPaused = true; video.pause(); }
      });

      // retire the poster the moment real frames exist, and only then
      video.addEventListener('playing', function () { btn.classList.add('is-playing'); }, { once: true });

      video.addEventListener('play', sync);
      video.addEventListener('pause', sync);
      sync();
    })();
  </script>

  {/* CLOSE */}
  <CloseCTA id="contact" />
</Base>

<script>
  import { wireHoverCards } from '../scripts/card-video';

  // Bento featured tiles. The hero video above has its own controller.
  wireHoverCards('.t-feat', '.tile-video');
</script>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + color */
  .t-stat .fig {
    font-family: var(--t-display-font); font-weight: var(--t-display-weight); letter-spacing: var(--t-display-track);
  }
  .jr-t {
    font-family: var(--t-h3-font); font-weight: var(--t-h3-weight); letter-spacing: var(--t-h3-track);
  }
  .hero .kick,
  .hero-video-state,
  .t-feat .meta .disc,
  .t-stat .lab,
  .mod .k,
  .mod .go,
  .jr-empty .jr-tag,
  .jr-m,
  .close .avail {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }


  /* ===== SPLIT HERO ===== */
  .hero { min-height: 100vh; display: flex; align-items: center; padding: var(--space-3xl) 0; }
  .hero-inner { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-3xl); align-items: center; width: 100%; }
  .hero-inner > div { display: flex; flex-direction: column; justify-content: center; }
  .hero .kick { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-secondary); margin-bottom: var(--space-lg); line-height: 1.7; }
  .hero h1 { margin: 0; }
  .hero .lead { margin-top: var(--space-lg); }
  .hero .btn-row { margin-top: var(--space-xl); }
  .hero-figure { position: relative; display: flex; flex-direction: column; }
  /* square (1:1) frame hosting the brand-mark animation (public/hero) */
  .hero-figure .frame { aspect-ratio: var(--ratio-square); }
  .hero-figure .frame img { width: 100%; height: 100%; object-fit: cover; }

  /* video is wrapped in a button so the whole surface is a click-to-pause
     target (keyboard-operable, labeled). The state chip fades in on hover
     or while paused, so the pause gesture is discoverable, not hidden. */
  .hero-video { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; position: relative; }
  .hero-video video { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Positioned, so it paints over the static <video> regardless of DOM order. Fades out once the clip is actually rendering frames, never on `play` alone — that fires before the first frame is decoded and would flash the empty video box. */
  .hero-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity var(--dur-quick) var(--ease-standard); }
  .hero-video.is-playing .hero-poster { opacity: 0; }
  .hero-video-state {
    position: absolute; bottom: 12px; right: 12px;
    /* fixed box + centered label so Play/Pause swap doesn't resize/shift it */
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 84px; height: 26px; box-sizing: border-box;
     font-size: var(--fs-2xs);
    line-height: 1; text-transform: uppercase;
    color: var(--n-50); background: var(--scrim-chip);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    padding: 0 var(--space-xs); border-radius: var(--radius-none);
    opacity: 0; transition: opacity var(--dur-quick) var(--ease-standard); pointer-events: none;
  }
  .hero-video:hover .hero-video-state,
  .hero-video:focus-visible .hero-video-state,
  .hero-video[aria-pressed="false"] .hero-video-state { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    /* show the poster still only; no controls affordance */
    .hero-video { cursor: default; }
    .hero-video-state { display: none; }
  }

  /* ===== BENTO — two equal 16:9 feature cards + a stat strip ===== */
  .bento { display: flex; flex-direction: column; gap: var(--space-md); }
  .feat-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  /* surface + hover come from global .card / .card--interactive */
  .card.t-feat, .card.t-stat { overflow: hidden; position: relative; }

  .t-feat { display: flex; flex-direction: column; }
  .t-feat .img { aspect-ratio: var(--ratio-wide); overflow: hidden; position: relative; }
  .t-feat .img img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-settle) var(--ease-standard); }
  .t-feat:hover .img img { transform: scale(var(--scale-hover)); }
  /* hover-to-play clip over the tile cover; poster shows at rest */
  .tile-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-settle) var(--ease-standard); }
  .t-feat:hover .tile-video { transform: scale(var(--scale-hover)); }
  .t-feat .meta { padding: var(--space-lg); display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-md); }
  .t-feat .meta p { font-size: var(--fs-sm); color: var(--text-secondary); margin-top: var(--space-xs); max-width: var(--measure-md); }
  .t-feat .meta .disc { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); text-align: right; white-space: nowrap; line-height: 1.8; }

  /* .badge / .badge.in-house / .badge.concept come from global.css */

  /* Figures top-align and labels bottom-align, so a two-line label cannot shift its
     figure out of line with the others. Centering the whole stack put cards 2 and 4 seven
     pixels above cards 1 and 3. The label reserves two lines for the same reason. */
  .t-stat { padding: var(--space-lg); display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-sm); min-height: 132px; }
  .t-stat .fig { font-size: var(--fs-fluid-2xl); line-height: 1; color: var(--text); }
  .t-stat .lab { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); line-height: 1.5; max-width: var(--measure-xs); min-height: 3em; }

  /* ===== MODULES ===== */
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  /* surface + hover come from global .card / .card--interactive */
  .mod { padding: var(--space-xl); display: flex; flex-direction: column; }
  .mod .k { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--accent-text); margin-bottom: var(--space-md); }
  .mod p { font-size: var(--fs-sm); color: var(--text-secondary); max-width: var(--measure-md); margin-top: var(--space-sm); }
  .mod .go { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text); margin-top: auto; padding-top: var(--space-lg); }
  /* About: headshot side-by-side, stretched to the text column's height */
  .mod-about { flex-direction: row; align-items: stretch; gap: var(--space-lg); }
  .mod-about .face { width: 160px; border-radius: var(--radius-md); flex: none; overflow: hidden; }
  .mod-about .face img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mod-about .about-body { flex: 1; display: flex; flex-direction: column; }
  @media (max-width: 560px) {
    .mod-about { flex-direction: column; align-items: flex-start; gap: var(--space-md); }
    .mod-about .face { width: 140px; aspect-ratio: var(--ratio-square); }
  }

  /* ===== JOURNAL ===== */
  /* surface comes from global .card */
  .jr-empty { padding: var(--space-2xl); display: flex; flex-direction: column; gap: var(--space-md); align-items: flex-start; }
  .jr-empty .jr-tag { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--accent-text); }
  .jr-empty p { font-size: var(--fs-xl); color: var(--text-secondary); }

  .jr-list { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  /* the hover nudge is .row-nudge in global.css — transform, not padding */
  .jr-row { display: grid; grid-template-columns: 1fr auto; gap: var(--space-xl); align-items: baseline; padding: var(--space-lg) 0; border-bottom: 1px solid var(--border); }
  .jr-t { font-size: var(--fs-fluid-md); color: var(--text-secondary); transition: color var(--dur-quick) var(--ease-standard); }
  .jr-row:hover .jr-t { color: var(--text); }
