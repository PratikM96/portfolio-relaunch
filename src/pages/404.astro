---
/**
 * 404. Astro emits this as /404.html; Cloudflare serves it on any unmatched route (which needs `not_found_handling` set, or it never reaches this page).
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

// No nav item is "active" on a 404.
---

<Base
  noindex={true}
  title="404 | Not found | Pratik Mehta"
  description="That page could not be found."
  activeNav=""
>
  <section class="nf">
    <PageHero class="nf-inner">
      <div class="page-kicker">[ 404 ]</div>
      <h1 class="page-h1">This page is off the system.</h1>
      <p class="nf-copy">The page you were after does not exist, or it moved. Everything still connects from here.</p>
      <div class="btn-row">
        <a class="btn btn-p" href="/">Back home →</a>
        <a class="btn btn-g" href="/work">View work →</a>
        <a class="btn btn-g" href="/contact">Get in touch →</a>
      </div>
    </PageHero>
  </section>
</Base>

<style>
  .nf { display: flex; align-items: center; min-height: 62vh; padding: var(--space-4xl) 0; }
  .nf-inner { max-width: 40rem; }
  .nf-copy { font-size: var(--fs-xl); line-height: 1.6; color: var(--text-secondary); margin: var(--space-lg) 0 var(--space-xl); max-width: 34rem; }
  @media (max-width: 900px) { .nf { min-height: 52vh; padding: var(--space-3xl) 0; } }
</style>
