---
/**
 * Contact. No status dot here: the one pulsing dot lives in the rail.
 */
import Base from '../layouts/Base.astro';

const EMAIL = 'mehtadpratik@gmail.com';
const LINKEDIN = 'https://www.linkedin.com/in/pratikm96';
import { siteOrigin, breadcrumb } from '../lib/schema';

// Depth-1 breadcrumb, matching /about. The child pages under /work and /journal already emit trails that point here, so the parents should exist as crumbs too.
const bcOrigin = siteOrigin(Astro.site);
const schema = [breadcrumb(bcOrigin, [{ name: 'Home', path: '/' }, { name: 'Contact' }])];

---

<Base
  schema={schema}
  title="Contact | Pratik Mehta"
  description="Get in touch with Pratik Mehta, Director of Marketing at International Student Exchange, based in New York."
  activeNav="contact"
>
  <section class="chero rev-load">
    <div class="page-kicker">[ Contact ]</div>
    {/* The meta pair sits above the head, matching the home hero and the closing CTA.
        Two lines, never joined: the `/` separates title from organization. */}
    <div class="avail">Based in New York<br />Director of Marketing / International Student Exchange</div>
    <h1 class="page-h1">Let's talk about the work, or the <span class="signal">problem behind it.</span></h1>

    <div class="cgrid">
      <a class="ccell" href={`mailto:${EMAIL}`}><span class="k">Email</span><span class="v">{EMAIL}</span></a>
      <a class="ccell" href={LINKEDIN} target="_blank" rel="noopener"><span class="k">LinkedIn</span><span class="v">in / pratikm96</span></a>
      <a class="ccell" href="/resume"><span class="k">Resume</span><span class="v">View resume →</span></a>
      <a class="ccell" href="/work"><span class="k">Work</span><span class="v">View work →</span></a>
    </div>
  </section>
</Base>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + color */
  .ccell .v {
    font-family: var(--t-h3-font); font-weight: var(--t-h3-weight); letter-spacing: var(--t-h3-track);
  }
  .chero .avail,
  .ccell .k {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }


  .chero { padding: var(--space-4xl) 0 var(--space-4xl); }
  .chero h1 { max-width: var(--measure-2xs); }
  /* the kicker's own gap tightens: kicker and avail are now a stacked pair above the head */
  .chero .page-kicker { margin-bottom: var(--space-sm); }
  .chero .avail { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-secondary); margin-bottom: var(--space-lg); line-height: var(--lh-relaxed); }

  /* one row of four on desktop; 2-up on tablet, 1-up on mobile */
  .cgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; margin-top: var(--space-2xl); max-width: 1040px; }
  .ccell { background: var(--surface); padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-sm); transition: background-color var(--dur-quick) var(--ease-standard); }
  .ccell:hover { background: var(--surface-raised); }
  .ccell .k { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); }
  .ccell .v { font-size: var(--fs-md); color: var(--text); word-break: break-word; transition: color var(--dur-quick) var(--ease-standard); }
  .ccell:hover .v { color: var(--accent-text); }

  @media (max-width: 900px) { .chero { padding: var(--space-3xl) 0 var(--space-3xl); } .cgrid { grid-template-columns: repeat(2, 1fr); max-width: 620px; } }
  @media (max-width: 560px) { .cgrid { grid-template-columns: 1fr; } }
</style>
