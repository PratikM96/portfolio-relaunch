---
/**
 * Journal article template — one page per non-draft `journal` entry: header, optional cover, markdown body, optional margin. Reuses the case-study rail variant rather than adding a Base variant.
 */
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { publishedJournal, formatDate } from '../../lib/content';
import { siteOrigin, personRef, websiteRef, breadcrumb } from '../../lib/schema';
import { ogCard } from '../../lib/media';

export const getStaticPaths = (async () => {
  return publishedJournal(await getCollection('journal'))
    .map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

const scoreboard = [
  d.topic && { k: 'Topic', v: d.topic },
  { k: 'Published', v: formatDate(d.date) },
  d.readingTime && { k: 'Read', v: d.readingTime },
].filter((x): x is { k: string; v: string } => Boolean(x));

const metaLine = [formatDate(d.date), d.readingTime].filter(Boolean).join(' / ');

/**
 * The "More writing" lists: the posts that FOLLOW this one in date order, wrapping around the end. Cycling is what makes each post's list its own, where "every other post, newest first" showed a near-identical set on all of them.
 *
 * Not tag-ranked on purpose. `tags` has no controlled vocabulary, so real siblings miss each other on near-synonyms ("AI" against "AI search") and the ranking would collapse back to date order while looking like relevance.
 *
 * Capped BELOW the post count so a cut actually happens. Raise the cap as the archive grows and every list becomes "all of them" again.
 */
const ordered = publishedJournal(await getCollection('journal'));
const here = ordered.findIndex((p) => p.id === post.id);
const others = Array.from({ length: Math.min(3, ordered.length - 1) }, (_, i) => ordered[(here + 1 + i) % ordered.length]);

// Shared author blurb — rendered in the desktop rail and the mobile post-foot.
const bio =
  'Pratik builds creative, social, and performance as one system, from the idea to what it does after it ships. Director of Marketing at an international nonprofit.';

// Structured data — BlogPosting + breadcrumb.
const origin = siteOrigin(Astro.site);
const postUrl = `${origin}/journal/${post.id}`;
const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${postUrl}#post`,
    headline: d.title,
    description: d.excerpt,
    url: postUrl,
    image: `${origin}${ogCard('journal')}`,
    datePublished: d.date.toISOString(),
    author: personRef(origin),
    publisher: personRef(origin),
    keywords: d.tags.join(', '),
    isPartOf: websiteRef(origin),
  },
  breadcrumb(origin, [
    { name: 'Home', path: '/' },
    { name: 'Journal', path: '/journal' },
    { name: d.title },
  ]),
];
---

<Base
  variant="case-study"
  image="/og/journal.png"
  schema={schema}
  title={`${d.title} | Journal | Pratik Mehta`}
  description={d.excerpt}
  sections={[]}
  scoreboard={scoreboard}
  back={{ href: '/journal', label: '← Journal / all writing' }}
>
  <header class="ahead rev-load">
    {d.tags.length > 0 && (
      <div class="cats">
        {d.tags.map((t, i) => (
          <span class:list={['tag', i === d.tags.length - 1 && 'acc']}>{t}</span>
        ))}
      </div>
    )}
    <h1 class="page-h1">{d.title}</h1>
    <div class="m">{metaLine}</div>
  </header>


  {/* Left console rail extras (journal only): author bio + other posts. Fills the
      case-study rail's otherwise-empty section-nav area. Hidden ≤900px (rail
      collapses to the drawer there); the mobile equivalent is .post-foot below. */}
  <Fragment slot="rail">
    <div class="rail-bio">
      <span class="bio-k">About</span>
      <p>{bio}</p>
      <a class="rail-bio-about" href="/about">More about Pratik →</a>
    </div>
    {others.length > 0 && (
      <div class="rail-more">
        <span class="bio-k">More writing</span>
        <nav class="rail-more-nav" aria-label="More writing">
          {others.map((p) => (
            <a href={`/journal/${p.id}`}>{p.data.title}</a>
          ))}
        </nav>
      </div>
    )}
  </Fragment>

  {/* Both blocks are ABOVE the fold on a post, so both take `.rev-load` (CLAUDE.md §6): a faded hero hands LCP to a later element, and an above-the-fold `.rev` also carries the reveal's opacity cost on the Speed Index clock. */}
  <article class="article">
    <div class="amain rev-load">
      <Content />
    </div>
    {d.pullquote && (
      <aside class="amargin rev-load" aria-label="Pull quote">
        <div class="m-quote"><p>{d.pullquote}</p></div>
      </aside>
    )}
  </article>

  {/* Mobile equivalent of the rail extras, ≤900px. */}
  <section class="post-foot rev">
    <div class="pf-about">
      <span class="pf-k">About</span>
      <p>{bio}</p>
      <a href="/about">More about Pratik →</a>
    </div>
    {others.length > 0 && (
      <div class="pf-more">
        <span class="pf-k">More writing</span>
        <ul>
          {others.map((p) => (
            <li><a href={`/journal/${p.id}`}>{p.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>

<style>
  /* type tiers — family/weight/tracking only; rules below set size + color */
  .amain :global(h2) {
    font-family: var(--t-h2-font); font-weight: var(--t-h2-weight); letter-spacing: var(--t-h2-track);
  }
  .amain :global(h3),
  .amain :global(p:first-child),
  .amain :global(blockquote),
  .m-quote p,
  .pf-more a {
    font-family: var(--t-h3-font); font-weight: var(--t-h3-weight); letter-spacing: var(--t-h3-track);
  }
  .ahead .m,
  .pf-k,
  .pf-about a {
    font-family: var(--t-label-font); font-weight: var(--t-label-weight); letter-spacing: var(--t-label-track);
  }


  /* Deliberately shallower than the other page heads: this one is followed by body
     copy rather than a section, and at 4xl/3xl the title and meta filled the first
     screen on their own. */
  .ahead { padding: var(--space-2xl) 0 var(--space-xl); max-width: var(--measure-3xl); }
  /* wrap: a category chip is `nowrap`, so the ROW has to be what gives */
  .ahead .cats { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-lg); }
  .ahead .m { font-size: var(--fs-2xs); text-transform: uppercase; color: var(--text-muted); margin-top: var(--space-lg); }

  /* .tag / .tag.acc come from global.css */


  .article { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: var(--space-3xl); align-items: start; padding-bottom: var(--space-4xl); }
  .amain { max-width: var(--measure-3xl); }
  /* body copy comes from the post markdown — style the rendered elements globally */
  .amain :global(p) { font-size: var(--fs-xl); line-height: var(--lh-relaxed); color: var(--text-secondary); margin-bottom: var(--space-lg); }
  /* The lede. h3 TIER at the 2xl step, so the weight is one the system already
     defines (Grotesk 500) rather than a hand-set number: it outweighs the body
     without borrowing the Display face the sub-heads own. */
  .amain :global(p:first-child) { font-size: var(--fs-2xl); line-height: var(--lh-snug); color: var(--text); margin-bottom: var(--space-xl); }
  .amain :global(h2) { font-size: var(--fs-2xl); margin: var(--space-2xl) 0 var(--space-md); }
  .amain :global(h3) { font-size: var(--fs-xl); margin: var(--space-xl) 0 var(--space-sm); }
  .amain :global(strong) { color: var(--text); font-weight: 600; }
  .amain :global(a) { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .amain :global(ul), .amain :global(ol) { margin: 0 0 var(--space-lg) var(--space-lg); color: var(--text-secondary); }
  .amain :global(li) { margin-bottom: var(--space-xs); line-height: var(--lh-relaxed); }
  .amain :global(blockquote) { border-left: 2px solid var(--accent-fill); padding-left: var(--space-lg); margin: 0 0 var(--space-lg); color: var(--text); }

  .amargin { display: flex; flex-direction: column; gap: var(--space-lg); position: sticky; top: 48px; }
  /* Beside the body, the rule caps the quote. Stacked, it moves under it — see
     the 1000px block, where the quote sits between the header and the body and
     the rule has to divide it from the copy, not from the title it belongs to. */
  .m-quote { border-top: 1px solid var(--border-strong); padding-top: var(--space-md); }
  .m-quote p { font-size: var(--fs-xl); line-height: var(--lh-h3); color: var(--text); }

  /* mobile post-foot: author + more writing, shown only where the rail is hidden */
  .post-foot { display: none; }
  .pf-k { font-size: var(--fs-3xs); text-transform: uppercase; color: var(--text-muted); display: block; margin-bottom: var(--space-md); }
  .pf-about p { font-size: var(--fs-md); line-height: var(--lh-relaxed); color: var(--text-secondary); max-width: var(--measure-xl); }
  .pf-about a { display: inline-block; margin-top: var(--space-sm); font-size: var(--fs-2xs); text-transform: uppercase; color: var(--accent-text); }
  .pf-more ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-md); }
  .pf-more a { font-size: var(--fs-lg); line-height: var(--lh-h3); color: var(--text-secondary); transition: color var(--dur-quick) var(--ease-standard); }
  .pf-more a:hover { color: var(--text); }

  @media (max-width: 1000px) {
    .article { grid-template-columns: 1fr; gap: var(--space-xl); }
    /* Stacked, source order drops the pull quote past the whole article. It is the
       post's thesis, so it leads instead: `order` moves it without a second copy
       in the markup. Above 1000px the sticky column already puts it up top. */
    .amargin { position: static; order: -1; flex-direction: row; flex-wrap: wrap; }
    .amargin > * { flex: 1; min-width: 220px; }
    /* The quote now belongs to the header block above it, so the rule goes under. */
    .m-quote { border-top: none; padding-top: 0; border-bottom: 1px solid var(--border-strong); padding-bottom: var(--space-lg); }
  }
  @media (max-width: 900px) {
    .ahead { padding: var(--space-xl) 0 var(--space-lg); }
    .article { padding-bottom: var(--space-2xl); }
    .post-foot {
      display: flex; flex-direction: column; gap: var(--space-xl);
      padding-top: var(--space-2xl); padding-bottom: var(--space-4xl);
      border-top: 1px solid var(--border);
    }
  }
</style>
