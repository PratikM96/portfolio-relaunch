    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.0.1",
    "puppeteer-core": "^25.3.0",
    "subset-font": "^2.5.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  }
