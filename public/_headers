# Cloudflare _headers — security + caching.
# The @astrojs/cloudflare adapter appends its own immutable rule for /_astro/* at build; everything below covers the rest.
# The CSP is ENFORCED, so a new external origin fails silently until it is allowlisted here. 'unsafe-inline' covers the inline theme/consent/demo scripts and style attributes, acceptable on a static site with no user input. Dropping it means hashing the inline scripts, which needs a build-time generator: Vite inlines bundles under assetsInlineLimit, so the hash set changes shape between builds.
# Cloudflare Web Analytics is off (its beacon slowed LCP), which is why static.cloudflareinsights.com is absent from script-src/connect-src.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://www.google-analytics.com; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://www.googletagmanager.com; upgrade-insecure-requests

# ===== A year, immutable =====
# These URLs are contract-named and unhashed (@font-face, preloads and the per-slug video conventions all hardcode them), so replacing a file's BYTES without changing its NAME will not reach a returning visitor for up to a year. To reach everyone, rename the file or drop `immutable` first. Adding a new slug or face is always safe.
#
# Replaced in place, knowingly: the Clash faces on 2026-07-15 (a cached subset still carries every glyph the site renders), and the sportime-clubs + agency-fiveeighty hero audio on 2026-07-27 (picture unchanged, so a stale copy is only missing an audio re-mix on a click-to-play video).

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Video only. Hero posters go through the image pipeline into /_astro/*, so they are content-hashed and a re-export reaches everyone.
/hero/*
  Cache-Control: public, max-age=31536000, immutable
/wc/*
  Cache-Control: public, max-age=31536000, immutable
/ov/*
  Cache-Control: public, max-age=31536000, immutable

# Concept microsite fonts, same contract as /fonts/*. Listed per slug because only one trailing wildcard is reliable, and a bare /concepts/* would sweep the microsite HTML into a year of caching.
/concepts/level/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/concepts/the-ninth/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/concepts/wisp/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ===== 30 days =====
# Unhashed and contract-named like the sets above, but redrawn occasionally. Long enough to kill per-navigation revalidation, short enough that replacing one in place still reaches people.
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon-16x16.png
  Cache-Control: public, max-age=2592000
/favicon-32x32.png
  Cache-Control: public, max-age=2592000
/favicon-96x96.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/site.webmanifest
  Cache-Control: public, max-age=2592000
/android-chrome-192x192.png
  Cache-Control: public, max-age=2592000
/android-chrome-512x512.png
  Cache-Control: public, max-age=2592000
/og/*
  Cache-Control: public, max-age=2592000
/llms.txt
  Cache-Control: public, max-age=2592000

# ===== A day =====
# The resume is replaced during an active search and is downloaded, not just rendered. A month of caching would hand a recruiter a superseded copy.
/pratik-mehta-resume.pdf
  Cache-Control: public, max-age=86400, must-revalidate

# ===== Revalidate every navigation =====
# Stated rather than inherited, so the policy is this repo's choice and not the platform default. A zero lifetime with must-revalidate lets a deploy reach a returning visitor immediately while still allowing a 304.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
